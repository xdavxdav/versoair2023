# Example nginx reverse-proxy config for the optional `nginx` service in
# docker-compose.prod.yml. Copy to `nginx.conf`, fill in your real domain and
# certificate paths, then enable the service with:
#   docker compose -f docker-compose.prod.yml --profile production up -d
#
# This is a starting point, not a turnkey config — review timeouts, logging,
# rate limiting, and certificate renewal (e.g. certbot) before relying on it.

events {
  worker_connections 1024;
}

http {
  upstream backend {
    server backend:5003;
  }

  server {
    listen 80;
    server_name your-domain.com;

    # Redirect all plain HTTP to HTTPS.
    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl http2;
    server_name your-domain.com;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    location / {
      proxy_pass http://backend;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
