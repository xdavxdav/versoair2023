{
  "React Functional Component": {
    "prefix": "rfc",
    "body": [
      "import { ${2} } from 'react';",
      "",
      "interface ${1:ComponentName}Props {",
      "  ${3}",
      "}",
      "",
      "export default function ${1:ComponentName}({ ${4} }: ${1:ComponentName}Props) {",
      "  return (",
      "    <div className=\"${5}\">",
      "      ${6}",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "React functional component with TypeScript"
  },
  "React Hook": {
    "prefix": "rhook",
    "body": [
      "import { useState, useEffect } from 'react';",
      "",
      "export function use${1:HookName}(${2}) {",
      "  const [${3:state}, set${3/(.*)/${3:/capitalize}/}] = useState(${4});",
      "",
      "  useEffect(() => {",
      "    ${5}",
      "  }, [${6}]);",
      "",
      "  return { ${3:state}, set${3/(.*)/${3:/capitalize}/} };",
      "}"
    ],
    "description": "Custom React hook with TypeScript"
  },
  "API Route Handler": {
    "prefix": "apihandler",
    "body": [
      "app.${1:get}('${2:/api/endpoint}', ${3:isAuthenticated, }async (req, res) => {",
      "  try {",
