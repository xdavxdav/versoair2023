  },
  "Drizzle Schema": {
    "prefix": "drizzletable",
    "body": [
      "export const ${1:tableName} = pgTable('${1:tableName}', {",
      "  id: serial('id').primaryKey(),",
      "  ${2:name}: varchar('${2:name}', { length: 255 }).notNull(),",
