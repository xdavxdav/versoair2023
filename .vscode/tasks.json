{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Development",
			"type": "shell",
			"command": "npm run dev",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "new"
			},
			"problemMatcher": []
		},
		{
			"label": "Build Production",
			"type": "shell",
			"command": "npm run build",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Database Push",
			"type": "shell",
			"command": "npm run db:push",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Database Studio",
			"type": "shell",
			"command": "npm run db:studio",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "new"
			}
		},
		{
			"label": "Type Check",
			"type": "shell",
			"command": "npx tsc --noEmit",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"panel": "shared"
			},
			"problemMatcher": "$tsc"
		},
		{
			"label": "Test Vault",
			"type": "shell",
			"command": "node /Users/joe/Downloads/FSA/_test_vault.mjs"
		},
		{
			"label": "Cleanup",
			"type": "shell",
			"command": "rm -f /Users/joe/Downloads/FSA/_test_vault.sh /Users/joe/Downloads/FSA/_test_vault.mjs /Users/joe/Downloads/FSA/_test_creds.mjs"
		}
	]
}