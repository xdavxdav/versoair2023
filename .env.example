# Verso Air Business Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in all required values before running.

# ─── Database (Required) ──────────────────────────────────────────────────────
# Full PostgreSQL connection string. For Neon: use pooler URL.
DATABASE_URL=postgresql://username:password@localhost:5432/versoair_db

# ─── Secrets (Required) ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the same value in multiple environments.
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── CORS (Required in production) ───────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = CORS blocked.
# Example: https://versoair.com,https://www.versoair.com
CORS_ORIGIN=

# ─── Production URLs (Required in production) ────────────────────────────────
PRODUCTION_URL=https://your-domain.com
MUSIC_APP_URL=https://your-music-service.com

# ─── Redis (Required in production) ──────────────────────────────────────────
# Without this, sessions and caches are in-memory and lost on restart.
REDIS_URL=redis://localhost:6379

# ─── Superadmin (Required in production) ─────────────────────────────────────
# The email address of the initial superadmin account.
# This user must be created via the seed script, NOT via registration.
SUPERADMIN_EMAIL=

# ─── Optional: Replit OAuth ───────────────────────────────────────────────────
# REPL_ID=your-replit-id
# ISSUER_URL=https://replit.com/oidc
# REPLIT_DOMAINS=your-domain.replit.app

# ─── Optional: External APIs ──────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# SENDGRID_API_KEY=SG....
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
