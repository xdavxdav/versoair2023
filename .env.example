# Verso Air Business Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in all required values before running.
# NEVER commit a real .env file. Only placeholders belong in this template.

# ─── Database (Required) ──────────────────────────────────────────────────────
# Full PostgreSQL connection string. For Neon: use pooler URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/versoair_business_intelligence

# ─── Secrets (Required) ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the same value in multiple environments.
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_EXPIRES_IN=7d
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5002
LOG_LEVEL=info
# Set to true only to skip DB connectivity checks in local/dev scripts
DISABLE_DB_CHECK=false

# ─── CORS (Required in production) ───────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = CORS blocked.
# Example: https://versoair.com,https://www.versoair.com
CORS_ORIGIN=

# ─── Production / cross-app URLs (Required in production) ───────────────────
# Use public custom-domain URLs in production; provider-internal hosts should not be exposed.
# MUSIC_APP_URL may be omitted when the music experience shares the main app origin.
PRODUCTION_URL=https://your-domain.com
APP_PUBLIC_URL=https://your-domain.com
MAIN_APP_URL=https://your-domain.com
MUSIC_APP_URL=https://music.your-domain.com/music
MUSIC_PORT=5004
SIBLING_URL=https://music.your-domain.com/music
VERSOAIR_URL=https://your-domain.com
# Auto-set by Render — do not set manually
# RENDER_EXTERNAL_URL=

# ─── Client build-time API URL (Required) ────────────────────────────────────
# Used by Vite/CRA/Next client bundles — must match your deployed API origin.
VITE_API_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com
REACT_APP_API_URL=https://your-domain.com

# ─── Redis (Required in production) ──────────────────────────────────────────
# Without this, sessions and caches are in-memory and lost on restart.
REDIS_URL=redis://localhost:6379
# Alternative: Upstash REST client (use instead of REDIS_URL)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Superadmin (Required in production) ─────────────────────────────────────
# The email address of the initial superadmin account.
# Created by seed script with random password (forced to change on first login).
# Default: superadmin@versoair.test
SUPERADMIN_EMAIL=superadmin@versoair.test
ADMIN_EMAIL=admin@versoair.com

# ─── Local GeoAdmin test accounts (development only) ─────────────────────────
# Configure these in your ignored .env, then run:
#   npm run db:seed-geoadmin-test
# The seeder refuses to run when NODE_ENV=production and accepts only .test emails.
# These are APP sign-in passwords, not DATABASE_URL or server connection passwords.
# Sign in normally with the email, or use the GeoAdmin username at the GeoAdmin gate;
# both methods use the same account password. Use unique local-only passwords of
# at least 12 characters. Never reuse these in production.
GEOADMIN_SUPERUSER_USERNAME=superadmin_test
GEOADMIN_SUPERUSER_EMAIL=superadmin@versoair.test
GEOADMIN_SUPERUSER_PASSWORD=REPLACE_WITH_LOCAL_SUPERUSER_PASSWORD
GEOADMIN_CEO_USERNAME=ceo_test
GEOADMIN_CEO_EMAIL=ceo@versoair.test
GEOADMIN_CEO_PASSWORD=REPLACE_WITH_LOCAL_CEO_PASSWORD
GEOADMIN_CEO2_USERNAME=ceo2_test
GEOADMIN_CEO2_EMAIL=ceo2@versoair.test
GEOADMIN_CEO2_PASSWORD=REPLACE_WITH_LOCAL_CEO2_PASSWORD
GEOADMIN_MODERATOR_USERNAME=moderator_test
GEOADMIN_MODERATOR_EMAIL=moderator@versoair.test
GEOADMIN_MODERATOR_PASSWORD=REPLACE_WITH_LOCAL_MODERATOR_PASSWORD

# ─── AI features (Optional) ───────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Only if self-hosting a local model instead of Groq
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ─── Email / SMTP (Optional — notifications disabled without these) ─────────
# CONTACT_EMAIL overrides ADMIN_EMAIL as the contact-form inbox. The app falls
# back to ADMIN_EMAIL, then SMTP_USER; inbound mail forwarding alone is not SMTP.
# ADMIN_EMAIL receives platform/admin alerts and can be a routed alias.
# SMTP_USER is only for outbound authentication.
# Outlook/Hotmail example:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=you@hotmail.com
# SMTP_PASS=YOUR_OUTLOOK_APP_PASSWORD_OR_MAIL_PASSWORD
# SMTP_FROM=you@hotmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=

# ─── Payments (Optional) ──────────────────────────────────────────────────────
# Keep these false until pricing, checkout, fulfilment, cancellation, refunds,
# and support handling have been tested end to end.
ONLINE_PAYMENTS_ENABLED=false
FREE_TRIALS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Public directory starts in one approved market. Change only when another
# market is actually operating and its business records have been verified.
VITE_DIRECTORY_COUNTRY_CODE=CA
VITE_DIRECTORY_MARKET_LABEL=Toronto, Canada

# ─── Misc ──────────────────────────────────────────────────────────────────────
# Signs ad-reward callbacks
AD_REWARD_SECRET=
# Zapier "Catch Hook" URL — fires on contact/ticket/artist-application/event
# submissions. Leave empty to disable (routes work fine without it).
ZAPIER_WEBHOOK_URL=

# ─── Optional: OAuth logins (only set the providers you enable) ─────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# REPL_ID=your-replit-id
# ISSUER_URL=https://replit.com/oidc
# REPLIT_DOMAINS=your-domain.replit.app

# ─── Optional: Job-board integrations (careers feature) ──────────────────────
# INDEED_CLIENT_ID=
# INDEED_CLIENT_SECRET=
# GLASSDOOR_CLIENT_ID=
# GLASSDOOR_CLIENT_SECRET=
