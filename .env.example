# Verso Air Business Intelligence Platform - Environment Configuration
# Copy this file to .env and fill in all required values before running.
# NEVER commit a real .env file. Only placeholders belong in this template.

# ─── Database (Required) ──────────────────────────────────────────────────────
# Full PostgreSQL connection string. For Neon: use pooler URL.
DATABASE_URL=postgresql://username:password@localhost:5432/versoair_business_intelligence

# ─── Secrets (Required) ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use the same value in multiple environments.
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
JWT_EXPIRES_IN=7d
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5002
LOG_LEVEL=info
# Set to true only to skip DB connectivity checks in local/dev scripts
DISABLE_DB_CHECK=false

# ─── CORS (Required in production) ───────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = CORS blocked.
# Example: https://versoair.com,https://www.versoair.com
CORS_ORIGIN=

# ─── Production / cross-app URLs (Required in production) ───────────────────
# ⚠️ CRITICAL: MUSIC_APP_URL MUST be set in production or server will crash
# Prevents accidental fallback to localhost:5004 on render.com
# Example (Render): https://your-music-service.onrender.com/music
PRODUCTION_URL=https://your-domain.com
APP_PUBLIC_URL=https://your-domain.com
MAIN_APP_URL=https://your-domain.com
MUSIC_APP_URL=https://your-music-service.onrender.com/music
MUSIC_PORT=5004
SIBLING_URL=https://your-music-service.onrender.com/music
VERSOAIR_URL=https://your-domain.com
# Auto-set by Render — do not set manually
# RENDER_EXTERNAL_URL=

# ─── Client build-time API URL (Required) ────────────────────────────────────
# Used by Vite/CRA/Next client bundles — must match your deployed API origin.
VITE_API_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com
REACT_APP_API_URL=https://your-domain.com

# ─── Redis (Required in production) ──────────────────────────────────────────
# Without this, sessions and caches are in-memory and lost on restart.
REDIS_URL=redis://localhost:6379
# Alternative: Upstash REST client (use instead of REDIS_URL)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Superadmin (Required in production) ─────────────────────────────────────
# The email address of the initial superadmin account.
# Created by seed script with random password (forced to change on first login).
# Default: superadmin@versoair.test
SUPERADMIN_EMAIL=superadmin@versoair.test
ADMIN_EMAIL=superadmin@versoair.test

# ─── AI features (Optional) ───────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Only if self-hosting a local model instead of Groq
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ─── Email / SMTP (Optional — notifications disabled without these) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Payments (Optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ─── Misc ──────────────────────────────────────────────────────────────────────
# Signs ad-reward callbacks
AD_REWARD_SECRET=

# ─── Optional: OAuth logins (only set the providers you enable) ─────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# REPL_ID=your-replit-id
# ISSUER_URL=https://replit.com/oidc
# REPLIT_DOMAINS=your-domain.replit.app

# ─── Optional: Job-board integrations (careers feature) ──────────────────────
# INDEED_CLIENT_ID=
# INDEED_CLIENT_SECRET=
# GLASSDOOR_CLIENT_ID=
# GLASSDOOR_CLIENT_SECRET=
