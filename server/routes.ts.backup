import type { Express } from "express";
import { createServer, type Server } from "http";
import { storage } from "./storage";
import {
  insertUserSchema,
  insertBusinessSchema,
  insertReservationSchema,
} from "@shared/schema";
import { z } from "zod";

export async function registerRoutes(app: Express): Promise<Server> {
  console.log("📁 [ROUTES] Registering API routes...");

  // =======================
  // TEST & DEBUG ROUTES
  // =======================

  app.get("/api/simple-test", (req, res) => {
    console.log("✅ [TEST] /api/simple-test hit");
    res.json({
      message: "Simple test works!",
      timestamp: new Date().toISOString(),
    });
  });

  app.get("/api/health", async (req, res) => {
    try {
      const { db } = await import("./db");
      const { sql } = await import("drizzle-orm");
      await db.execute(sql`SELECT 1 as health_check`);
      res.json({
        status: "healthy",
        timestamp: new Date().toISOString(),
        database: "connected",
      });
    } catch (error) {
      console.error("Health check error:", error);
      res.status(503).json({
        status: "unhealthy",
        timestamp: new Date().toISOString(),
        database: "disconnected",
        error: error.message,
      });
    }
  });

  app.get("/api/debug/db-info", async (req, res) => {
    try {
      const { db } = await import("./db");
      const { sql } = await import("drizzle-orm");

      console.log("🔍 [DEBUG] Testing database connection");

      const userResult = await db.execute(
        sql`SELECT current_user, current_database()`
      );
      console.log("🔍 [DEBUG] Current user:", userResult.rows[0].current_user);

      const tableExists = await db.execute(sql`
        SELECT EXISTS (
          SELECT FROM information_schema.tables 
          WHERE table_schema = 'public' 
          AND table_name = 'businesses'
        ) as exists
      `);

      const allTables = await db.execute(sql`
        SELECT tablename, tableowner 
        FROM pg_tables 
        WHERE schemaname = 'public'
        ORDER BY tablename
      `);

      res.json({
        databaseInfo: userResult.rows[0],
        businessesTableExists: tableExists.rows[0].exists,
        allTables: allTables.rows,
        timestamp: new Date().toISOString(),
        status: "success",
      });
    } catch (error) {
      console.error("❌ [DEBUG] Debug route error:", error);
      res.status(500).json({
        error: error.message,
        status: "failed",
      });
    }
  });

  app.get("/api/test-businesses", async (req, res) => {
    try {
      console.log("🔍 [TEST] Testing businesses access");

      const { db } = await import("./db");
      const { sql } = await import("drizzle-orm");

      const userResult = await db.execute(
        sql`SELECT current_user, current_database()`
      );
      console.log("🔍 [TEST] Current user:", userResult.rows[0].current_user);

      const result = await db.execute(sql`SELECT * FROM businesses LIMIT 5`);
      console.log("🔍 [TEST] Direct query result:", result.rows);

      res.json({
        success: true,
        user: userResult.rows[0],
        businesses: result.rows,
        count: result.rows.length,
      });
    } catch (error) {
      console.error("❌ [TEST] Error:", error);
      res.status(500).json({
        success: false,
        error: error.message,
        details: "Test endpoint failed",
      });
    }
  });

  // =======================
  // AUTHENTICATION ROUTES
  // =======================

  app.post("/api/auth/register", async (req, res) => {
    try {
      const userData = insertUserSchema.parse(req.body);
      const user = await storage.createUser(userData);
      res.json({ user: { ...user, password: undefined } });
    } catch (error) {
      console.error("Registration error:", error);
      if (error instanceof z.ZodError) {
        return res
          .status(400)
          .json({ error: "Invalid user data", details: error.errors });
      }
      res.status(500).json({ error: "Registration failed" });
    }
  });

  app.post("/api/auth/login", async (req, res) => {
    try {
      const { email, password } = req.body;

      if (!email || !password) {
        return res
          .status(400)
          .json({ error: "Email and password are required" });
      }

      const user = await storage.getUserByEmail(email);

      if (!user || user.password !== password) {
        return res.status(401).json({ error: "Invalid credentials" });
      }

      res.json({ user: { ...user, password: undefined } });
    } catch (error) {
      console.error("Login error:", error);
      res.status(500).json({ error: "Login failed" });
    }
  });

  // =======================
  // LOCATION DATA ROUTES
  // =======================

  app.get("/api/countries", async (req, res) => {
    try {
      const countries = await storage.getCountries();
      console.log(`✅ [COUNTRIES] Returning ${countries.length} countries`);
      res.json(countries);
    } catch (error) {
      console.error("Countries error:", error);
      res.status(500).json({ error: "Failed to fetch countries" });
    }
  });

  app.get("/api/regions", async (req, res) => {
    try {
      const { countryId } = req.query;
      const regions = await storage.getRegions(
        countryId ? parseInt(countryId as string) : undefined
      );
      res.json(regions);
    } catch (error) {
      console.error("Regions error:", error);
      res.status(500).json({ error: "Failed to fetch regions" });
    }
  });

  app.get("/api/cities", async (req, res) => {
    try {
      const { regionId } = req.query;
      const cities = await storage.getCities(
        regionId ? parseInt(regionId as string) : undefined
      );
      res.json(cities);
    } catch (error) {
      console.error("Cities error:", error);
      res.status(500).json({ error: "Failed to fetch cities" });
    }
  });

  // =======================
  // BUSINESS ROUTES
  // =======================

  app.get("/api/categories", async (req, res) => {
    try {
      const categories = await storage.getBusinessCategories();
      res.json(categories);
    } catch (error) {
      console.error("Categories error:", error);
      res.status(500).json({ error: "Failed to fetch categories" });
    }
  });

  app.get("/api/categories/:slug", async (req, res) => {
    try {
      const category = await storage.getBusinessCategoryBySlug(req.params.slug);
      if (!category) {
        return res.status(404).json({ error: "Category not found" });
      }
      res.json(category);
    } catch (error) {
      console.error("Category by slug error:", error);
      res.status(500).json({ error: "Failed to fetch category" });
    }
  });

  app.get("/api/businesses", async (req, res) => {
    try {
      const { categoryId } = req.query;
      console.log(
        `🔍 [BUSINESSES] Fetching businesses, categoryId: ${categoryId}`
      );

      const businesses = await storage.getBusinesses(
        categoryId ? parseInt(categoryId as string) : undefined
      );

      console.log(`✅ [BUSINESSES] Returning ${businesses.length} businesses`);
      res.json(businesses);
    } catch (error) {
      console.error("❌ [BUSINESSES] Error:", error);
      res.status(500).json({
        error: "Failed to fetch businesses",
        details: error.message,
      });
    }
  });

  app.post("/api/businesses", async (req, res) => {
    try {
      const businessData = insertBusinessSchema.parse(req.body);
      const business = await storage.createBusiness(businessData);
      res.status(201).json(business);
    } catch (error) {
      console.error("Create business error:", error);
      if (error instanceof z.ZodError) {
        return res
          .status(400)
          .json({ error: "Invalid business data", details: error.errors });
      }
      res.status(500).json({ error: "Failed to create business" });
    }
  });

  // =======================
  // ANALYTICS ROUTES
  // =======================

  app.get("/api/analytics/:categorySlug", async (req, res) => {
    try {
      console.log("Fetching analytics for category:", req.params.categorySlug);
      const analytics = await storage.getAnalyticsByCategory(
        req.params.categorySlug
      );
      console.log("Analytics result:", analytics);
      res.json(analytics);
    } catch (error) {
      console.error(
        "Analytics error for category",
        req.params.categorySlug,
        ":",
        error
      );
      res.status(500).json({ error: "Failed to fetch analytics" });
    }
  });

  app.get("/api/analytics/business/:businessId", async (req, res) => {
    try {
      const businessId = parseInt(req.params.businessId);
      if (isNaN(businessId)) {
        return res.status(400).json({ error: "Invalid business ID" });
      }

      const analytics = await storage.getAnalyticsByBusiness(businessId);
      res.json(analytics);
    } catch (error) {
      console.error("Business analytics error:", error);
      res.status(500).json({ error: "Failed to fetch business analytics" });
    }
  });

  // =======================
  // RESERVATIONS ROUTES
  // =======================

  app.get("/api/reservations", async (req, res) => {
    try {
      const reservations = await storage.getReservations();
      res.json(reservations);
    } catch (error) {
      console.error("Reservations error:", error);
      res.status(500).json({ error: "Failed to fetch reservations" });
    }
  });

  app.post("/api/reservations", async (req, res) => {
    try {
      const reservationData = insertReservationSchema.parse(req.body);
      const reservation = await storage.createReservation(reservationData);
      res.status(201).json(reservation);
    } catch (error) {
      console.error("Create reservation error:", error);
      if (error instanceof z.ZodError) {
        return res
          .status(400)
          .json({ error: "Invalid reservation data", details: error.errors });
      }
      res.status(500).json({ error: "Failed to create reservation" });
    }
  });

  // =======================
  // MUSIC ROUTES
  // =======================

  app.get("/api/music/artists", async (req, res) => {
    try {
      const artists = await storage.getMusicArtists();
      res.json(artists);
    } catch (error) {
      console.error("Music artists error:", error);
      res.status(500).json({ error: "Failed to fetch artists" });
    }
  });

  app.get("/api/music/tracks", async (req, res) => {
    try {
      const tracks = await storage.getMusicTracks();
      res.json(tracks);
    } catch (error) {
      console.error("Music tracks error:", error);
      res.status(500).json({ error: "Failed to fetch tracks" });
    }
  });

  app.get("/api/music/analytics", async (req, res) => {
    try {
      const analytics = await storage.getMusicAnalytics();
      res.json(analytics);
    } catch (error) {
      console.error("Music analytics error:", error);
      res.status(500).json({ error: "Failed to fetch music analytics" });
    }
  });

  // =======================
  // 🏨 HOTELS ROUTES (DIRECTLY IN THIS FILE)
  // =======================

  // GET /api/hotellerie - Main hotels endpoint
  app.get("/api/hotellerie", async (req, res) => {
    try {
      const mockHotels = [
        {
          id: 1,
          name: "Luxury Palace Hotel & Spa",
          description:
            "5-star luxury resort with panoramic ocean views and world-class amenities",
          location: "Victoria Island, Lagos",
          rating: 5,
          image_url:
            "https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800",
          price: 450,
          featured: true,
          views: 1247,
          likes: 89,
          amenities: ["spa", "pool", "restaurant", "concierge"],
        },
        {
          id: 2,
          name: "Grand Meridian Resort",
          description:
            "Award-winning beachfront resort with exceptional dining experiences",
          location: "Lekki, Lagos",
          rating: 5,
          image_url:
            "https://images.unsplash.com/photo-1520250497591-112f2f40a3f4?w=800",
          price: 380,
          featured: true,
          views: 982,
          likes: 67,
          amenities: ["pool", "restaurant", "spa", "beach-access"],
        },
        {
          id: 3,
          name: "Executive Business Hotel",
          description:
            "Modern business hotel with state-of-the-art conference facilities",
          location: "Ikeja, Lagos",
          rating: 4,
          image_url:
            "https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?w=800",
          price: 220,
          featured: false,
          views: 654,
          likes: 43,
          amenities: ["conference", "wifi", "restaurant", "gym"],
        },
      ];

      console.log("✅ [HOTELS] Returning mock hotels data");
      res.json(mockHotels);
    } catch (error) {
      console.error("Hotels API error:", error);
      res.status(500).json({ error: "Failed to fetch hotels" });
    }
  });

  // GET /api/hotellerie/search - Search hotels
  app.get("/api/hotellerie/search", async (req, res) => {
    try {
      const { query, location, category } = req.query;

      console.log("🔍 [HOTELS SEARCH] Query:", { query, location, category });

      // For now, return empty results or mock data
      const searchResults = [];

      res.json({
        results: searchResults,
        query: query || "",
        total: searchResults.length,
      });
    } catch (error) {
      console.error("Hotels search error:", error);
      res.status(500).json({ error: "Search failed" });
    }
  });

  // GET /api/hotellerie/analytics - Hotel analytics
  app.get("/api/hotellerie/analytics", async (req, res) => {
    try {
      const mockAnalytics = {
        occupancyRate: 78,
        occupancyChange: 12,
        averageDailyRate: 245,
        dailyRateChange: 8,
        guestSatisfaction: 4.7,
        satisfactionChange: 5,
        revenuePerRoom: 189,
        revenueChange: 15,
        roomPerformance: [
          { name: "Deluxe Suite", occupancy: "85%", rate: 450 },
          { name: "Executive Room", occupancy: "78%", rate: 320 },
          { name: "Standard Room", occupancy: "72%", rate: 245 },
          { name: "Family Suite", occupancy: "68%", rate: 380 },
        ],
        guestDemographics: [
          { type: "Business", percentage: "45%", nights: "2.3" },
          { type: "Leisure", percentage: "35%", nights: "4.1" },
          { type: "Family", percentage: "15%", nights: "5.2" },
          { type: "Couples", percentage: "5%", nights: "3.8" },
        ],
        performanceMetrics: [
          { metric: "RevPAR", value: "€189", change: "+15%" },
          { metric: "ADR", value: "€245", change: "+8%" },
          { metric: "Occupancy", value: "78%", change: "+12%" },
          { metric: "Guest Score", value: "4.7/5", change: "+5%" },
        ],
      };

      console.log("✅ [HOTELS ANALYTICS] Returning mock analytics");
      res.json(mockAnalytics);
    } catch (error) {
      console.error("Hotels analytics error:", error);
      res.status(500).json({ error: "Failed to fetch analytics" });
    }
  });

  // =======================
  // LOCATION SERVICES
  // =======================

  app.get("/api/location/analytics", async (req, res) => {
    try {
      const locationData = {
        currentLocation: "Paris, France",
        postalCode: "75001",
        coordinates: { latitude: 48.8566, longitude: 2.3522 },
        wifiProvider: "Orange France",
        networkType: "WiFi 6 (802.11ax)",
        signalStrength: "Excellent (-35 dBm)",
        ipAddress: "82.64.127.45",
        internetProvider: "Orange Business Services",
        timezone: "Europe/Paris (CET)",
        localTime: new Date().toLocaleString("fr-FR", {
          timeZone: "Europe/Paris",
        }),
        altitude: "35m above sea level",
        district: "1st Arrondissement (Louvre)",
        nearbyLandmarks: [
          "Louvre Museum (0.3km)",
          "Palais Royal (0.2km)",
          "Pont Neuf (0.4km)",
        ],
        activeUsers: 2547,
        coverageAreas: 95,
        responseTime: "0.8s",
        regions: [
          { name: "North", coverage: 85 },
          { name: "East", coverage: 92 },
          { name: "South", coverage: 78 },
          { name: "West", coverage: 88 },
          { name: "Center", coverage: 95 },
        ],
      };
      res.json(locationData);
    } catch (error) {
      console.error("Location analytics error:", error);
      res.status(500).json({ error: "Failed to fetch location analytics" });
    }
  });

  console.log("✅ [ROUTES] All routes registered successfully");
  const httpServer = createServer(app);
  return httpServer;
}
