import { Helmet } from 'react-helmet-async';
import { useState, useEffect } from "react";
import { Link } from "wouter";
import {
  Calendar,
  Users,
  MapPin,
  Clock,
  Zap,
  ArrowRight,
  BookOpen,
  Award,
  AlertCircle,
} from "lucide-react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { useScrollLock } from "@/hooks/use-scroll-lock";

interface Workshop {
  id: string;
  title: string;
  artisan: string;
  specialty: string;
  date: string;
  time: string;
  location: string;
  duration: string;
  level: "Beginner" | "Intermediate" | "Advanced";
  price: number;
  capacity: number;
  enrolled: number;
  description: string;
  skills: string[];
  image?: string;
}

// Workshop data — populated as artisans schedule workshops
const WORKSHOPS: Workshop[] = [];

export default function ArtisanWorkshops() {
  const [selectedLevel, setSelectedLevel] = useState("All");
  const [searchQuery, setSearchQuery] = useState("");
  const [filteredWorkshops, setFilteredWorkshops] = useState(WORKSHOPS);
  const [selectedWorkshop, setSelectedWorkshop] = useState<Workshop | null>(
    null,
  );
  useScrollLock(!!selectedWorkshop);

  const levels = ["All", "Beginner", "Intermediate", "Advanced"];

  useEffect(() => {
    let filtered = WORKSHOPS;

    if (selectedLevel !== "All") {
      filtered = filtered.filter((w) => w.level === selectedLevel);
    }

    if (searchQuery) {
      filtered = filtered.filter(
        (w) =>
          w.title.toLowerCase().startsWith(searchQuery.toLowerCase()) ||
          w.artisan.toLowerCase().startsWith(searchQuery.toLowerCase()) ||
          w.specialty.toLowerCase().startsWith(searchQuery.toLowerCase()),
      );
    }

    setFilteredWorkshops(filtered);
  }, [searchQuery, selectedLevel]);

  return (
    <>
      <Helmet>
        <title>artisan-workshops — Verso Air</title>
        <meta name="description" content="artisan-workshops — Verso Air" />
      </Helmet>
      <div className="flex flex-col min-h-screen bg-gradient-to-b from-white to-gray-50">
      {/* Hero Section */}
      <div className="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white py-12 md:py-16">
        <div className="max-w-[95vw] mx-auto px-4">
          <h1 className="text-4xl md:text-5xl font-bold mb-4">
            Artisan Workshops
          </h1>
          <p className="text-lg text-emerald-50 max-w-2xl">
            Learn directly from master artisans. Register for hands-on workshops
            and develop real craft skills.
          </p>
        </div>
      </div>

      {/* Main Content */}
      <div className="max-w-[95vw] mx-auto px-4 py-12">
        {/* Search & Filters */}
        <div className="mb-8 space-y-4">
          <div className="relative">
            <BookOpen className="absolute left-3 top-3 h-5 w-5 text-gray-400" />
            <input
              type="text"
              placeholder="Search workshops, artisans, or specialties..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          {/* Level Filter */}
          <div className="flex flex-wrap gap-2">
            {levels.map((level) => (
              <button
                key={level}
                onClick={() => setSelectedLevel(level)}
                className={`px-4 py-2 rounded-full font-medium transition-all ${
                  selectedLevel === level
                    ? "bg-emerald-600 text-white shadow-lg"
                    : "bg-gray-200 text-gray-700 hover:bg-gray-300"
                }`}
              >
                {level}
              </button>
            ))}
          </div>
        </div>

        {/* Results */}
        <p className="text-gray-600 mb-6">
          Found <strong>{filteredWorkshops.length}</strong> workshop
          {filteredWorkshops.length !== 1 ? "s" : ""}
        </p>

        {/* Workshops Grid */}
        {filteredWorkshops.length > 0 ? (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            {filteredWorkshops.map((workshop) => {
              const availableSpots = workshop.capacity - workshop.enrolled;
              const isAlmostFull = availableSpots <= 2;

              return (
                <div key={workshop.id} className="group">
                  <Card className="h-full border-0 shadow-lg hover:shadow-xl transition-all overflow-hidden flex flex-col">
                    {/* Header */}
                    <CardHeader className="pb-3 bg-gradient-to-r from-emerald-50 to-emerald-100/50">
                      <div className="flex items-start justify-between mb-2">
                        <div className="flex-1">
                          <CardTitle className="text-lg text-gray-900">
                            {workshop.title}
                          </CardTitle>
                          <CardDescription className="text-emerald-700 font-medium">
                            {workshop.artisan}
                          </CardDescription>
                        </div>
                        <span
                          className={`text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap ${
                            workshop.level === "Beginner"
                              ? "bg-green-100 text-green-700"
                              : workshop.level === "Intermediate"
                                ? "bg-yellow-100 text-yellow-700"
                                : "bg-red-100 text-red-700"
                          }`}
                        >
                          {workshop.level}
                        </span>
                      </div>
                    </CardHeader>

                    <CardContent className="pt-4 space-y-4 flex-grow">
                      {/* Workshop Details */}
                      <div className="space-y-3">
                        <div className="flex items-center gap-2 text-sm text-gray-700">
                          <Calendar className="h-4 w-4 text-emerald-600" />
                          {new Date(workshop.date).toLocaleDateString("en-US", {
                            weekday: "short",
                            month: "short",
                            day: "numeric",
                          })}
                        </div>
                        <div className="flex items-center gap-2 text-sm text-gray-700">
                          <Clock className="h-4 w-4 text-emerald-600" />
                          {workshop.time} ({workshop.duration})
                        </div>
                        <div className="flex items-center gap-2 text-sm text-gray-700">
                          <MapPin className="h-4 w-4 text-emerald-600" />
                          {workshop.location}
                        </div>
                      </div>

                      {/* Description */}
                      <p className="text-sm text-gray-600">
                        {workshop.description}
                      </p>

                      {/* Skills */}
                      <div>
                        <p className="text-xs font-semibold text-gray-600 mb-2">
                          You'll Learn:
                        </p>
                        <div className="flex flex-wrap gap-2">
                          {workshop.skills.slice(0, 2).map((skill, idx) => (
                            <span
                              key={idx}
                              className="text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded"
                            >
                              {skill}
                            </span>
                          ))}
                          {workshop.skills.length > 2 && (
                            <span className="text-xs bg-emerald-100 text-emerald-700 px-2 py-1 rounded">
                              +{workshop.skills.length - 2} more
                            </span>
                          )}
                        </div>
                      </div>

                      {/* Availability */}
                      <div className="flex items-center justify-between pt-3 border-t border-gray-200">
                        <div className="flex items-center gap-2 text-sm">
                          <Users className="h-4 w-4 text-emerald-600" />
                          <span
                            className={
                              isAlmostFull
                                ? "text-red-600 font-bold"
                                : "text-gray-700"
                            }
                          >
                            {availableSpots} spots left
                          </span>
                        </div>
                        <span className="text-lg font-bold text-emerald-600">
                          {workshop.price.toLocaleString()} XOF
                        </span>
                      </div>

                      {/* Warning */}
                      {isAlmostFull && (
                        <div className="flex items-center gap-2 bg-red-50 p-2 rounded-lg">
                          <AlertCircle className="h-4 w-4 text-red-600" />
                          <span className="text-xs text-red-700 font-medium">
                            Almost full!
                          </span>
                        </div>
                      )}
                    </CardContent>

                    {/* Partake Button */}
                    <div className="p-4 bg-gradient-to-r from-emerald-600 to-emerald-700">
                      <button
                        onClick={() => setSelectedWorkshop(workshop)}
                        className="w-full group/btn bg-white text-emerald-700 font-bold py-2 px-4 rounded-lg hover:bg-emerald-50 transition-all transform hover:scale-105 active:scale-95 flex items-center justify-center gap-2 relative overflow-hidden"
                      >
                        <span className="relative z-10 flex items-center gap-2">
                          <Zap className="h-4 w-4" />
                          Partake Now
                          <ArrowRight className="h-4 w-4 group-hover/btn:translate-x-1 transition-transform" />
                        </span>
                      </button>
                    </div>
                  </Card>
                </div>
              );
            })}
          </div>
        ) : (
          <Card className="text-center py-12 border-0 shadow-lg bg-gray-50">
            <BookOpen className="h-12 w-12 mx-auto text-emerald-300 mb-4" />
            <h3 className="text-lg font-semibold text-gray-700 mb-2">
              {WORKSHOPS.length === 0 && !searchQuery && selectedLevel === "All"
                ? "Workshop Schedule Ready"
                : "No workshops found"}
            </h3>
            <p className="text-gray-500 mb-4">
              {WORKSHOPS.length === 0 && !searchQuery && selectedLevel === "All"
                ? "Workshops will appear here as artisans schedule new sessions."
                : "Try adjusting your filters"}
            </p>
            {(searchQuery || selectedLevel !== "All") && (
              <Button
                onClick={() => {
                  setSearchQuery("");
                  setSelectedLevel("All");
                }}
                variant="outline"
              >
                Clear Filters
              </Button>
            )}
          </Card>
        )}

        {/* Workshop Registration Modal */}
        {selectedWorkshop && (
          <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
            <Card className="max-w-2xl w-full max-h-[90vh] overflow-y-auto border-0 shadow-2xl">
              <CardHeader className="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white">
                <div className="flex items-start justify-between">
                  <div>
                    <CardTitle className="text-2xl">
                      {selectedWorkshop.title}
                    </CardTitle>
                    <CardDescription className="text-emerald-100 mt-2">
                      with {selectedWorkshop.artisan}
                    </CardDescription>
                  </div>
                  <button
                    onClick={() => setSelectedWorkshop(null)}
                    className="text-white hover:bg-white/20 rounded-full p-2"
                  >
                    ✕
                  </button>
                </div>
              </CardHeader>

              <CardContent className="p-6 space-y-6">
                {/* Workshop Info */}
                <div className="grid md:grid-cols-2 gap-4">
                  <div>
                    <p className="text-xs text-gray-500 uppercase font-bold mb-1">
                      Date & Time
                    </p>
                    <p className="text-lg font-bold text-gray-900">
                      {new Date(selectedWorkshop.date).toLocaleDateString(
                        "en-US",
                        {
                          weekday: "long",
                          month: "long",
                          day: "numeric",
                        },
                      )}
                    </p>
                    <p className="text-sm text-gray-600">
                      {selectedWorkshop.time}
                    </p>
                  </div>
                  <div>
                    <p className="text-xs text-gray-500 uppercase font-bold mb-1">
                      Location
                    </p>
                    <p className="text-lg font-bold text-gray-900">
                      {selectedWorkshop.location}
                    </p>
                    <p className="text-sm text-gray-600">
                      {selectedWorkshop.duration}
                    </p>
                  </div>
                </div>

                {/* Price & Availability */}
                <div className="grid md:grid-cols-2 gap-4 p-4 bg-emerald-50 rounded-lg">
                  <div>
                    <p className="text-xs text-gray-500 uppercase font-bold mb-1">
                      Price
                    </p>
                    <p className="text-2xl font-bold text-emerald-700">
                      {selectedWorkshop.price.toLocaleString()} XOF
                    </p>
                  </div>
                  <div>
                    <p className="text-xs text-gray-500 uppercase font-bold mb-1">
                      Availability
                    </p>
                    <p className="text-2xl font-bold text-emerald-700">
                      {selectedWorkshop.capacity - selectedWorkshop.enrolled}/
                      {selectedWorkshop.capacity} spots
                    </p>
                  </div>
                </div>

                {/* Full Description */}
                <div>
                  <h3 className="font-bold text-gray-900 mb-2">
                    About This Workshop
                  </h3>
                  <p className="text-gray-700">
                    {selectedWorkshop.description}
                  </p>
                </div>

                {/* Skills List */}
                <div>
                  <h3 className="font-bold text-gray-900 mb-3">You'll Learn</h3>
                  <ul className="space-y-2">
                    {selectedWorkshop.skills.map((skill, idx) => (
                      <li
                        key={idx}
                        className="flex items-center gap-3 text-gray-700"
                      >
                        <Award className="h-5 w-5 text-emerald-600 flex-shrink-0" />
                        <span>{skill}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Registration Form */}
                <div className="space-y-4 p-4 bg-gray-50 rounded-lg">
                  <h3 className="font-bold text-gray-900">
                    Registration Details
                  </h3>
                  <div className="space-y-3">
                    <input
                      type="text"
                      placeholder="Full Name"
                      className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    />
                    <input
                      type="email"
                      placeholder="Email Address"
                      className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    />
                    <input
                      type="tel"
                      placeholder="Phone Number"
                      className="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    />
                  </div>
                </div>

                {/* Action Buttons */}
                <div className="flex gap-3">
                  <Link href="/reservations" className="flex-1">
                    <Button className="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold">
                      Continue to Payment
                    </Button>
                  </Link>
                  <Button
                    onClick={() => setSelectedWorkshop(null)}
                    variant="outline"
                    className="px-6 font-bold"
                  >
                    Cancel
                  </Button>
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        {/* Info Section */}
        <div className="bg-gradient-to-r from-emerald-50 to-emerald-100/50 rounded-xl p-8 border border-emerald-200">
          <h2 className="text-2xl font-bold text-emerald-900 mb-4">
            Workshop Details
          </h2>
          <div className="grid md:grid-cols-3 gap-6">
            <div>
              <h3 className="font-bold text-emerald-900 mb-2">
                Hands-On Learning
              </h3>
              <p className="text-emerald-800 text-sm">
                Work directly with master artisans in well-equipped studios with
                all materials provided.
              </p>
            </div>
            <div>
              <h3 className="font-bold text-emerald-900 mb-2">Small Groups</h3>
              <p className="text-emerald-800 text-sm">
                Limited capacity ensures personalized attention and quality
                instruction from experts.
              </p>
            </div>
            <div>
              <h3 className="font-bold text-emerald-900 mb-2">Certificates</h3>
              <p className="text-emerald-800 text-sm">
                Receive completion certificates that recognize your new skills
                in traditional crafts.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </>
  );
}
