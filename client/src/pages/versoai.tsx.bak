                  </a>
                </li>
                <li>
                  <a
                    href="/blog"
                    className="text-blue-200/70 hover:text-white transition-colors text-sm"
                  >
                    Blog
                  </a>
                </li>
                <li>
                  <a
                    href="/contact"
                    className="text-blue-200/70 hover:text-white transition-colors text-sm"
                  >
                    Contact
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <h4 className="text-white font-semibold mb-4">Resources</h4>
              <ul className="space-y-3">
                <li>
                  <a
                    href="/docs"
                    className="text-blue-200/70 hover:text-white transition-colors text-sm"
                  >
                    Documentation
                  </a>
                </li>
                <li>
                  <a
                    href="/help"
                    className="text-blue-200/70 hover:text-white transition-colors text-sm"
                  >
                    Help Center
                  </a>
                </li>
                <li>
                  <a
                    href="/partners"
                    className="text-blue-200/70 hover:text-white transition-colors text-sm"
                  >
                    Partners
                  </a>
                </li>
                <li>
                  <a
                    href="/status"
                    className="text-blue-200/70 hover:text-white transition-colors text-sm"
                  >
                    System Status
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <div className="pt-8 border-t border-blue-500/20 text-center">
            <p className="text-blue-200/50 text-sm">
              © {new Date().getFullYear()} Verso Air. All rights reserved.
              Powered by VersoAI.
            </p>
          </div>
        </div>
      </footer>

      <style>{`
        @keyframes spin-slow {
          from {
            transform: rotate(0deg);
          }
          to {
            transform: rotate(360deg);
          }
        }

        @keyframes spin-slow-reverse {
          from {
            transform: rotate(360deg);
          }
          to {
            transform: rotate(0deg);
          }
        }

        @keyframes spin-slower {
          from {
            transform: rotate(0deg);
          }
          to {
            transform: rotate(-360deg);
          }
        }

        @keyframes eaglePulse {
          0%,
          100% {
            transform: scale(1);
            opacity: 0.9;
          }
          50% {
            transform: scale(1.05);
            opacity: 1;
          }
        }

        /* Debug: force visible planet-info when debug toggle is on */
        .planet-info.debug-force-visible {
          opacity: 1 !important;
          transform: translate(-50%, -50%) scale(1) !important;
          display: block !important;
          visibility: visible !important;
          pointer-events: auto !important;
        }

        @keyframes float {
          0%,
          100% {
            transform: translate(-50%, calc(-50% - 3px));
          }
          50% {
            transform: translate(-50%, calc(-50% + 3px));
          }
        }

        @keyframes cursorGlow {
          0%,
          100% {
            box-shadow:
              0 0 0 2px rgba(255, 255, 255, 0.1),
              0 0 10px 4px rgba(96, 165, 250, 0.2),
              0 0 20px 8px rgba(147, 51, 234, 0.15),
              inset 0 0 20px rgba(255, 255, 255, 0.05);
          }
          50% {
            box-shadow:
              0 0 0 2px rgba(255, 255, 255, 0.15),
              0 0 15px 6px rgba(96, 165, 250, 0.3),
              0 0 30px 12px rgba(147, 51, 234, 0.25),
              inset 0 0 30px rgba(255, 255, 255, 0.08);
          }
        }

        /* Astronomy/astrology spinner */
        .astro-spinner {
          width: 10px;
          height: 10px;
          border-radius: 50%;
          border: 2px solid rgba(255,255,255,0.12);
          border-top-color: rgba(255,255,255,0.95);
          display: inline-block;
          animation: spin 1s linear infinite;
        }

        @keyframes spin {
          to { transform: rotate(360deg); }
        }

        @keyframes twinkle {
          0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); filter: blur(0px); }
          50% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); filter: blur(0.8px); }
        }

        /* Hover via either planet container or the small hit-target (2cm radius) */
        .planet:hover .planet-visual,
        .planet .planet-hit:hover ~ .planet-visual {
          transform: translate(-50%, -50%) scale(1.5) !important;
          filter: brightness(1.5);
          box-shadow:
            0 0 40px currentColor,
            0 0 80px currentColor,
            inset 0 0 30px rgba(255, 255, 255, 0.2);
          z-index: 100 !important;
          animation: cursorGlow 1.5s ease-in-out infinite;
        }

        /* Info cards hidden by default; shown only when planet is active (clicked) */
        .planet .planet-info {
          opacity: 0;
          transform: translateX(-50%) scale(0.9);
          pointer-events: none;
          transition: all 0.3s ease;
          width: 260px; /* slightly wider to accommodate longer content */
          max-height: 320px;
          overflow: auto;
          padding-right: 6px; /* space for scrollbar */
        }

        .planet[data-active="true"] .planet-info {
          opacity: 1;
          transform: translateX(-50%) scale(1);
          pointer-events: auto;
        }

        /* Make clickable hit-targets visually identifiable */
        .planet .planet-hit.clickable-hit {
          background: transparent;
          transition: box-shadow 0.18s ease, transform 0.12s ease;
        }

        /* When debug is enabled, make hit targets visible */
        .planet .planet-hit.debug-visible {
          background: rgba(99,102,241,0.06);
          box-shadow: 0 0 0 3px rgba(99,102,241,0.14);
          border: 1px dashed rgba(99,102,241,0.24);
        }

        .planet .planet-hit.clickable-hit:hover,
        .planet .planet-hit.clickable-hit:focus-visible {
          box-shadow: 0 0 0 6px rgba(96,165,250,0.08), 0 0 18px rgba(96,165,250,0.06);
          transform: translate(-50%, -50%) scale(1.02);
        }

        /* Focus styles for keyboard users */
        .planet .planet-hit:focus {
          outline: none;
        }

        .planet .planet-hit:focus-visible {
          box-shadow: 0 0 0 6px rgba(96,165,250,0.16), 0 0 0 3px rgba(96,165,250,0.26) inset;
          border-radius: 50%;
          transition: box-shadow 0.15s ease;
        }

        /* Provide a visible ring when planet is active (for keyboard users) */
        .planet[data-active="true"] .planet-hit:focus-visible,
        .planet[data-active="true"] .planet-visual {
          box-shadow: 0 0 30px currentColor, 0 0 60px currentColor, inset 0 0 20px rgba(255,255,255,0.08);
        }

        /* Solar system cursor decoration */
        .solar-system {
          position: relative;
          cursor: default; /* show cursor over the whole solar system */
        }

        .solar-system:hover {
          cursor: pointer;
        }

        .solar-system::before {
          content: "";
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          pointer-events: none;
          z-index: 9999;
          opacity: 0;
          transition: opacity 0.3s ease;
        }

        .solar-system:hover::before {
          opacity: 1;
        }

        /* Responsive adjustments */
        @media (max-width: 600px) {
          .planet-info {
            width: 160px;
            padding: 12px 14px;
            font-size: 11px;
          }

          .planet-info h3 {
            font-size: 12px;
          }

          .planet-info p {
            font-size: 10px;
          }
        }

        @media (max-height: 500px) {
          .eagle-center {
            width: 25%;
            height: 25%;
          }

          .planet:hover .planet-info {
            top: -130px;
          }
        }
      `}</style>
    </div>
  );
}
