                  <span className="text-amber-400 text-sm font-medium inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                    {svc.cta}
                    <ArrowRight className="h-4 w-4" />
                  </span>
                </CardContent>
              </Card>
            </Link>
          ))}
        </div>
      </section>

      {/* Pricing Preview */}
      {packs && packs.length > 0 && (
        <section className="max-w-[95vw] mx-auto px-4 py-16">
          <h2 className="text-2xl font-bold text-white mb-2 text-center">
            Marketing Packs
          </h2>
          <p className="text-gray-400 text-center mb-8">
            Choose the right package for your business
          </p>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {packs.slice(0, 4).map((pack: any) => (
              <Card
                key={pack.id}
                className={`bg-gray-800/50 border-gray-700 ${
                  pack.tier === "premium"
                    ? "border-amber-500 ring-1 ring-amber-500/30"
                    : ""
                }`}
              >
                <CardHeader>
                  {pack.tier === "premium" && (
                    <div className="inline-flex items-center gap-1 text-amber-400 text-xs font-semibold mb-2">
                      <Star className="h-3 w-3 fill-amber-400" />
                      MOST POPULAR
                    </div>
                  )}
                  <CardTitle className="text-white">{pack.name}</CardTitle>
                  <div className="text-3xl font-bold text-white">
                    ${(pack.price_cents / 100).toFixed(0)}
                    <span className="text-sm font-normal text-gray-400">
                      /pack
                    </span>
                  </div>
                </CardHeader>
                <CardContent>
                  <p className="text-gray-400 text-sm mb-4">
                    {pack.description}
                  </p>
                  <Link href="/marketing/packs">
                    <Button className="w-full bg-amber-500 hover:bg-amber-600 text-black">
