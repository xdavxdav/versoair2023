              {itemCount > 0 && (
                <Link href="/marketing/cart">
                  <Button
                    size="lg"
                    variant="outline"
                    className="border-amber-500/50 text-amber-400"
                  >
                    <ShoppingCart className="h-5 w-5 mr-2" />
