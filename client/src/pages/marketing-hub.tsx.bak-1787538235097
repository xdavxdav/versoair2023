import { Helmet } from 'react-helmet-async';
import { useState } from "react";
import { Link } from "wouter";
import { useQuery } from "@tanstack/react-query";
import {
  Newspaper,
  Package,
  Printer,
  Mail,
  ShoppingCart,
  TrendingUp,
  ArrowRight,
  Megaphone,
  Star,
  Zap,
} from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { useCart } from "@/hooks/use-cart";

export default function MarketingHub() {
  const { itemCount } = useCart();

  const { data: packs } = useQuery({
    queryKey: ["marketing", "packs"],
    queryFn: async () => {
      const res = await fetch("/api/marketing/packs");
      if (!res.ok) return [];
      const json = await res.json();
      return json.data || [];
    },
    staleTime: 60_000,
  });

  const services = [
    {
      title: "Free Ad Journal",
      description:
        "Publish your business in our free print & digital journal distributed across your area.",
      icon: Newspaper,
      color: "text-blue-400",
      bgColor: "bg-blue-500/10",
      href: "/marketing/journal",
      cta: "Submit Your Ad",
    },
    {
      title: "Marketing Packs",
      description:
        "Professional marketing bundles from $29 — flyers, banners, social media kits, and more.",
      icon: Package,
      color: "text-amber-400",
      bgColor: "bg-amber-500/10",
      href: "/marketing/packs",
      cta: "View Packs",
    },
    {
      title: "Print Services",
      description:
        "High-quality printing — business cards, brochures, posters, large format, and custom orders.",
      icon: Printer,
      color: "text-green-400",
      bgColor: "bg-green-500/10",
      href: "/marketing/print",
      cta: "Browse Catalog",
    },
    {
      title: "Newsletter",
      description:
        "Stay informed with industry insights, marketing tips, and exclusive offers delivered to your inbox.",
      icon: Mail,
      color: "text-purple-400",
      bgColor: "bg-purple-500/10",
      href: "/marketing/newsletters",
      cta: "Subscribe Free",
    },
  ];

  return (
    <>
      <Helmet>
        <title>marketing-hub — Verso Air</title>
        <meta name="description" content="marketing-hub — Verso Air" />
      </Helmet>
      <div className="min-h-screen bg-gradient-to-b from-gray-950 via-gray-900 to-gray-950">
      {/* Hero */}
      <section className="relative overflow-hidden">
        <div className="absolute inset-0 bg-gradient-to-r from-amber-600/10 via-transparent to-purple-600/10" />
        <div className="max-w-[95vw] mx-auto px-4 py-20 relative">
          <div className="text-center max-w-3xl mx-auto">
            <div className="inline-flex items-center gap-2 bg-amber-500/10 text-amber-400 px-4 py-1.5 rounded-full text-sm font-medium mb-6">
              <Megaphone className="h-4 w-4" />
              Verso Air Marketing Platform
            </div>
            <h1 className="text-4xl md:text-6xl font-bold text-white mb-6">
              Grow Your Business with{" "}
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-500">
                Powerful Marketing
              </span>
            </h1>
            <p className="text-lg text-gray-400 mb-8">
              Free ad journal, professional marketing packs, premium print
              services, and targeted newsletters — everything you need to reach
              more customers.
            </p>
            <div className="flex flex-wrap justify-center gap-4">
              <Link href="/marketing/journal">
                <Button
                  size="lg"
                  className="bg-amber-500 hover:bg-amber-600 text-black font-semibold"
                >
                  <Newspaper className="h-5 w-5 mr-2" />
                  Free Ad Journal
                </Button>
              </Link>
              <Link href="/marketing/packs">
                <Button
                  size="lg"
                  variant="outline"
                  className="border-gray-600 text-white hover:bg-gray-800"
                >
                  <Package className="h-5 w-5 mr-2" />
