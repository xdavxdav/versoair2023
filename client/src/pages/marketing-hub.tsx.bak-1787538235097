          Our Services
        </h2>
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map((svc) => (
            <Link key={svc.href} href={svc.href}>
              <Card className="bg-gray-800/50 border-gray-700 hover:border-amber-500/50 transition-all cursor-pointer h-full group">
                <CardHeader>
                  <div
                    className={`w-12 h-12 rounded-lg ${svc.bgColor} flex items-center justify-center mb-3`}
                  >
                    <svc.icon className={`h-6 w-6 ${svc.color}`} />
                  </div>
                  <CardTitle className="text-white text-lg">
                    {svc.title}
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <p className="text-gray-400 text-sm mb-4">
