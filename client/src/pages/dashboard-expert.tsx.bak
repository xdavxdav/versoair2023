// Admin user interface
interface AdminUser {
  id: string;
  name: string;
  email: string;
  role: "admin" | "editor" | "viewer";
  lastLogin: string;
  avatar?: string;
}

export default function DatabaseExpert() {
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedCategory, setSelectedCategory] = useState("all");
  const [selectedTable, setSelectedTable] = useState<string | null>(null);
  const [activeTab, setActiveTab] = useState("dashboard");
  const [databaseHealth, setDatabaseHealth] = useState<DatabaseHealth | null>(
    null,
  );
  const [connectionStatus, setConnectionStatus] = useState<
    "connecting" | "connected" | "disconnected"
  >("connecting");
  const [lastFetchTime, setLastFetchTime] = useState<Date | null>(null);
  const [showAddModal, setShowAddModal] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const [showDeleteModal, setShowDeleteModal] = useState(false);
  const [showViewDataModal, setShowViewDataModal] = useState(false);
  const [showQueryEditor, setShowQueryEditor] = useState(false);
  const [showBackupModal, setShowBackupModal] = useState(false);
  const [showSettingsModal, setShowSettingsModal] = useState(false);
  const [showNotifications, setShowNotifications] = useState(false);
  const [showUserMenu, setShowUserMenu] = useState(false);
  const [showMobileMenu, setShowMobileMenu] = useState(false);
  const [currentTableData, setCurrentTableData] = useState<any[]>([]);
  const [isLoadingData, setIsLoadingData] = useState(false);
  const [formData, setFormData] = useState<Record<string, any>>({});
  const [recordToDelete, setRecordToDelete] = useState<any>(null);
  const [currentPage, setCurrentPage] = useState(1);
  const [totalRecords, setTotalRecords] = useState(0);
  const [sqlQuery, setSqlQuery] = useState<string>(
    "SELECT * FROM users LIMIT 10",
  );
  const [queryResult, setQueryResult] = useState<QueryResult | null>(null);
  const [isExecutingQuery, setIsExecutingQuery] = useState(false);
  const [backupType, setBackupType] = useState<"full" | "partial" | "schema">(
    "full",
  );
  const [viewMode, setViewMode] = useState<"grid" | "list">("list");
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [notifications, setNotifications] = useState([
    {
      id: "1",
      title: "Database Backup",
      description: "Daily backup completed successfully",
      time: "5 min ago",
      read: false,
      type: "success",
    },
    {
      id: "2",
      title: "High CPU Usage",
      description: "Database CPU usage at 85%",
      time: "15 min ago",
      read: false,
      type: "warning",
    },
    {
      id: "3",
      title: "New Table Added",
      description: "Table 'audit_logs' created",
      time: "1 hour ago",
      read: true,
      type: "info",
    },
    {
      id: "4",
      title: "Connection Issue",
      description: "Connection lost for 30 seconds",
      time: "2 hours ago",
      read: true,
      type: "error",
    },
  ]);

  const recordsPerPage = 20;
  const queryEditorRef = useRef<HTMLTextAreaElement>(null);

  // Bulletproof database health check
  const { data: healthData, refetch: refetchHealth } = useQuery<DatabaseHealth>(
    {
      queryKey: ["database-expert-health"],
      queryFn: async () => {
        try {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 10000);

          const response = await fetch(`${API_BASE_URL}/api/health`, {
            signal: controller.signal,
            headers: {
              "Cache-Control": "no-cache",
              Pragma: "no-cache",
            },
          });

          clearTimeout(timeoutId);

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          const data = await response.json();
          return {
            ...data,
            database: {
              ...data.database,
              connected: true,
            },
          };
        } catch (error: any) {
          console.error("Database health check failed:", error.message);
          return {
            success: false,
            message: error.message || "Connection timeout",
            database: {
              connected: false,
              name: DB_CONFIG.database,
              host: DB_CONFIG.host,
              port: String(DB_CONFIG.port),
              user: DB_CONFIG.user,
              version: "Unknown",
              uptime: "0",
              connections: 0,
            },
          };
        }
      },
      retry: 3,
      retryDelay: (attemptIndex) => Math.min(1000 * 2 ** attemptIndex, 30000),
      refetchInterval: 30000,
      refetchOnWindowFocus: true,
      refetchOnMount: true,
      refetchOnReconnect: true,
      staleTime: 0,
      gcTime: 0,
    },
  );

  // Bulletproof tables fetch
  const { data: tablesData, refetch: refetchTables } = useQuery<
    DatabaseTable[]
  >({
    queryKey: ["database-expert-tables"],
    queryFn: async () => {
      if (!healthData?.database?.connected) {
        return [];
      }

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 15000);

        const response = await fetch(`${API_BASE_URL}/api/tables`, {
          signal: controller.signal,
          headers: {
            "Cache-Control": "no-cache",
            Pragma: "no-cache",
          },
        });

        clearTimeout(timeoutId);

        if (!response.ok) {
          console.warn(`Tables fetch returned ${response.status}`);
          return [];
        }

        const data = await response.json();

        // Handle different response formats
        if (Array.isArray(data)) {
          return data;
        } else if (data.data && Array.isArray(data.data)) {
          return data.data;
        } else if (data.tables && Array.isArray(data.tables)) {
          return data.tables;
        }

        return [];
      } catch (error: any) {
        // Silently log the error without showing toast
        console.warn("Tables fetch skipped:", error.message);
        return [];
      }
    },
    enabled: healthData?.database?.connected === true,
    retry: false,
    retryDelay: 2000,
    staleTime: 30000,
  });

  useEffect(() => {
    if (healthData) {
      setDatabaseHealth(healthData);
      setConnectionStatus(
        healthData.database?.connected ? "connected" : "disconnected",
      );
      setLastFetchTime(new Date());
    }
  }, [healthData]);

  // Auto-refresh effect
  useEffect(() => {
    if (!autoRefresh) return;

    const interval = setInterval(() => {
      refetchHealth();
      refetchTables();
    }, 30000); // Refresh every 30 seconds

    return () => clearInterval(interval);
  }, [autoRefresh, refetchHealth, refetchTables]);

  // Filter tables based on search and category
  const filteredTables = useMemo(() => {
    return ALL_TABLES.filter((table) => {
      const matchesSearch =
        searchQuery === "" ||
        table.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        (table.displayName ?? "")
          .toLowerCase()
          .includes(searchQuery.toLowerCase()) ||
        (table.description ?? "")
          .toLowerCase()
          .includes(searchQuery.toLowerCase()) ||
        table.tags?.some((tag) =>
          tag.toLowerCase().includes(searchQuery.toLowerCase()),
        );

      const matchesCategory =
        selectedCategory === "all" || table.category === selectedCategory;

      return matchesSearch && matchesCategory;
    });
  }, [searchQuery, selectedCategory]);

  // Get category stats
  const categoryStats = useMemo(() => {
    const stats: Record<
      string,
      { tables: number; rows: number; size: number }
    > = {};

    ALL_TABLES.forEach((table) => {
      if (!stats[table.category]) {
        stats[table.category] = { tables: 0, rows: 0, size: 0 };
      }
      stats[table.category].tables += 1;
      stats[table.category].rows += table.rowCount;
      stats[table.category].size += table.sizeMB;
    });

    return stats;
  }, []);

  // Format helpers
  const formatNumber = (num: number): string => {
    if (num >= 1000000) return `${(num / 1000000).toFixed(1)}M`;
    if (num >= 1000) return `${(num / 1000).toFixed(1)}K`;
    return num.toString();
  };

  const formatSize = (bytes: number): string => {
    const mb = bytes / (1024 * 1024);
    if (mb >= 1024) return `${(mb / 1024).toFixed(2)} GB`;
    return `${mb.toFixed(2)} MB`;
  };

  const formatFileSize = (bytes: number): string => {
    const sizes = ["Bytes", "KB", "MB", "GB", "TB"];
    if (bytes === 0) return "0 Bytes";
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return `${(bytes / Math.pow(1024, i)).toFixed(2)} ${sizes[i]}`;
  };

  const getTimeSince = (date: Date | null): string => {
    if (!date) return "Never";
    const seconds = Math.floor((new Date().getTime() - date.getTime()) / 1000);
    if (seconds < 60) return `${seconds}s ago`;
    if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
    return `${Math.floor(seconds / 3600)}h ago`;
  };

  // CRUD API Functions
  const fetchTableData = async (tableName: string, page: number = 1) => {
    setIsLoadingData(true);
    try {
      const response = await fetch(
        `${API_BASE_URL}/api/admin/table/${tableName}?page=${page}&limit=${recordsPerPage}`,
      );
      if (!response.ok) throw new Error("Failed to fetch table data");
      const data = await response.json();
      setCurrentTableData(data.data || data);
      setTotalRecords(data.total || data.length);
      setCurrentPage(page);
      return data;
    } catch (error: any) {
      toast({
        title: "Error Loading Data",
        description: error.message,
        variant: "destructive",
      });
      return [];
    } finally {
      setIsLoadingData(false);
    }
  };

  const createRecord = async (tableName: string, data: any) => {
    try {
      const response = await fetch(
        `${API_BASE_URL}/api/admin/table/${tableName}`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        },
      );
      if (!response.ok) throw new Error("Failed to create record");
      const result = await response.json();
      toast({
        title: "Success",
        description: `Record created successfully in ${tableName}`,
      });
      return result;
    } catch (error: any) {
      toast({
        title: "Error Creating Record",
        description: error.message,
        variant: "destructive",
      });
      throw error;
    }
  };

  const updateRecord = async (tableName: string, id: any, data: any) => {
    try {
      const response = await fetch(
        `${API_BASE_URL}/api/admin/table/${tableName}/${id}`,
        {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        },
      );
      if (!response.ok) throw new Error("Failed to update record");
      const result = await response.json();
      toast({
        title: "Success",
        description: `Record updated successfully in ${tableName}`,
      });
      return result;
    } catch (error: any) {
      toast({
        title: "Error Updating Record",
        description: error.message,
        variant: "destructive",
      });
      throw error;
    }
  };

  const deleteRecord = async (tableName: string, id: any) => {
    try {
      const response = await fetch(
        `${API_BASE_URL}/api/admin/table/${tableName}/${id}`,
        {
          method: "DELETE",
        },
      );
      if (!response.ok) throw new Error("Failed to delete record");
      toast({
        title: "Success",
        description: `Record deleted successfully from ${tableName}`,
      });
      return true;
    } catch (error: any) {
      toast({
        title: "Error Deleting Record",
        description: error.message,
        variant: "destructive",
      });
      throw error;
    }
  };

  // Database operations
  const handleTestConnection = useCallback(async () => {
    setConnectionStatus("connecting");
    try {
      await refetchHealth();
      toast({
        title: "Connection Test",
        description: "Successfully connected to database",
      });
    } catch (error) {
      toast({
        title: "Connection Failed",
        description: "Could not connect to database",
        variant: "destructive",
      });
    }
  }, [refetchHealth]);

  const handleOptimizeDatabase = useCallback(async () => {
    toast({
      title: "Optimization Started",
      description: "Database optimization in progress...",
    });
    // Simulate optimization
    await new Promise((resolve) => setTimeout(resolve, 2000));
    toast({
      title: "Optimization Complete",
      description: "Database performance has been optimized",
    });
  }, []);

  const handleExecuteQuery = async () => {
    if (!sqlQuery.trim()) {
      toast({
        title: "Error",
        description: "Please enter a SQL query",
        variant: "destructive",
      });
      return;
    }

    setIsExecutingQuery(true);
    try {
      const response = await fetch(`${API_BASE_URL}/api/admin/execute-query`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: sqlQuery }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message || "Query execution failed");
      }

      const result: QueryResult = await response.json();
      setQueryResult(result);

      if (result.success) {
        toast({
          title: "Query Executed",
          description: `Query completed in ${result.duration}ms, returned ${result.rowCount} rows`,
        });
      } else {
        toast({
          title: "Query Error",
          description: result.error || "Query execution failed",
          variant: "destructive",
        });
      }
    } catch (error: any) {
      toast({
        title: "Query Error",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsExecutingQuery(false);
    }
  };

  const handleCreateBackup = async () => {
    toast({
      title: "Backup Started",
      description: `Creating ${backupType} backup...`,
    });

    // Simulate backup creation
    await new Promise((resolve) => setTimeout(resolve, 3000));

    toast({
      title: "Backup Complete",
      description: `${backupType} backup created successfully`,
    });

    setShowBackupModal(false);
  };

  const handleExportData = (
    tableName: string,
    format: "csv" | "json" | "sql",
  ) => {
    toast({
      title: "Export Started",
      description: `Exporting ${tableName} to ${format.toUpperCase()}...`,
    });

    // In a real app, this would trigger a download
    setTimeout(() => {
      toast({
        title: "Export Complete",
        description: `${tableName}.${format} downloaded successfully`,
      });
    }, 1500);
  };

  const handleImportData = (tableName: string) => {
    const input = document.createElement("input");
    input.type = "file";
    input.accept = ".csv,.json,.sql";
    input.onchange = (e: any) => {
      const file = e.target.files[0];
      if (file) {
        toast({
          title: "Import Started",
          description: `Importing data to ${tableName}...`,
        });

        // Simulate import
        setTimeout(() => {
          toast({
            title: "Import Complete",
            description: `Data imported successfully to ${tableName}`,
          });
        }, 2000);
      }
    };
    input.click();
  };

  const handleClearNotifications = () => {
    setNotifications(notifications.map((n) => ({ ...n, read: true })));
  };

  const handleMarkAllAsRead = () => {
    setNotifications(notifications.map((n) => ({ ...n, read: true })));
    toast({
      title: "Notifications",
      description: "All notifications marked as read",
    });
  };

  // Admin action handlers
  const handleViewData = async (table: (typeof ALL_TABLES)[0]) => {
    setSelectedTable(table.name);
    await fetchTableData(table.name);
    setShowViewDataModal(true);
  };

  const handleAddRecord = (table: (typeof ALL_TABLES)[0]) => {
    setSelectedTable(table.name);
    setFormData({});
    setShowAddModal(true);
  };

  const handleEditRecord = (record: any) => {
    setFormData(record);
    setShowEditModal(true);
  };

  const handleDeleteClick = (record: any) => {
    setRecordToDelete(record);
    setShowDeleteModal(true);
  };

  const handleSubmitAdd = async () => {
    if (!selectedTable) return;
    try {
      await createRecord(selectedTable, formData);
      setShowAddModal(false);
      setFormData({});
      if (showViewDataModal) {
        await fetchTableData(selectedTable, currentPage);
      }
    } catch (error) {
      // Error already handled in createRecord
    }
  };

  const handleSubmitEdit = async () => {
    if (!selectedTable || !formData.id) return;
    try {
      await updateRecord(selectedTable, formData.id, formData);
      setShowEditModal(false);
      setFormData({});
      if (showViewDataModal) {
        await fetchTableData(selectedTable, currentPage);
      }
    } catch (error) {
      // Error already handled in updateRecord
    }
  };

  const handleConfirmDelete = async () => {
    if (!selectedTable || !recordToDelete?.id) return;
    try {
      await deleteRecord(selectedTable, recordToDelete.id);
      setShowDeleteModal(false);
      setRecordToDelete(null);
      if (showViewDataModal) {
        await fetchTableData(selectedTable, currentPage);
      }
    } catch (error) {
      // Error already handled in deleteRecord
    }
  };

  const handleCopyToClipboard = async (text: string) => {
    await navigator.clipboard.writeText(text);
    toast({
      title: "Copied",
      description: "Copied to clipboard",
    });
  };

  // Render connection status badge
  const ConnectionStatusBadge = () => {
    switch (connectionStatus) {
      case "connected":
        return (
          <Badge className="bg-gradient-to-r from-emerald-500 to-green-500 text-white border-0 shadow-sm">
            <CheckCircle className="h-3 w-3 mr-1" />
            Live
          </Badge>
        );
      case "connecting":
        return (
          <Badge className="bg-gradient-to-r from-amber-500 to-orange-500 text-white border-0 shadow-sm">
            <Loader2 className="h-3 w-3 mr-1 animate-spin" />
            Connecting...
          </Badge>
        );
      case "disconnected":
        return (
          <Badge className="bg-gradient-to-r from-rose-500 to-pink-500 text-white border-0 shadow-sm">
            <XCircle className="h-3 w-3 mr-1" />
            Disconnected
          </Badge>
        );
    }
  };

  // Render category card
  const CategoryCard = ({
    category,
  }: {
    category: (typeof EXPERT_CATEGORIES)[0];
  }) => {
    const Icon = category.icon;
    const stats = categoryStats[category.id] || { tables: 0, rows: 0, size: 0 };
    const tablesInCategory = ALL_TABLES.filter(
      (t) => t.category === category.id,
    );

    return (
      <Card className="group border-0 shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-[1.02] cursor-pointer overflow-hidden bg-gradient-to-br from-white to-gray-50/50 backdrop-blur-sm">
        <div
          className={`absolute top-0 left-0 right-0 h-1 ${category.gradient}`}
        />
        <CardHeader className="pb-4">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div
                className={`p-2.5 rounded-lg ${category.gradient} shadow-md`}
              >
                <Icon className="h-5 w-5 text-white" />
              </div>
              <div>
                <CardTitle className="text-gray-900">{category.name}</CardTitle>
                <CardDescription>{category.description}</CardDescription>
              </div>
            </div>
            <Badge variant="outline" className="font-mono">
              {stats.tables}
            </Badge>
          </div>
        </CardHeader>
        <CardContent className="pt-0">
          <div className="space-y-4">
            <div className="grid grid-cols-3 gap-3">
              <div className="text-center">
                <div className="text-xl font-bold text-gray-900">
                  {formatNumber(stats.rows)}
                </div>
                <div className="text-xs text-gray-500">Records</div>
              </div>
              <div className="text-center">
                <div className="text-xl font-bold text-gray-900">
                  {formatSize(stats.size * 1024 * 1024)}
                </div>
                <div className="text-xs text-gray-500">Size</div>
              </div>
              <div className="text-center">
                <div className="text-xl font-bold text-gray-900">
                  {tablesInCategory.reduce((sum, t) => sum + t.columns, 0)}
                </div>
                <div className="text-xs text-gray-500">Columns</div>
              </div>
            </div>

            <div className="space-y-2">
              {tablesInCategory.slice(0, 3).map((table) => (
                <div
                  key={table.name}
                  className="flex items-center justify-between p-2 hover:bg-gray-50/50 rounded-lg transition-colors"
                >
                  <div className="flex items-center gap-2">
                    <span className="text-lg">{table.icon}</span>
                    <div>
                      <div className="text-sm font-medium">
                        {table.displayName}
                      </div>
                      <div className="text-xs text-gray-500 truncate">
                        {(table.rowCount ?? 0).toLocaleString()} rows
                      </div>
                    </div>
                  </div>
                  {table.hasFK && <Link2 className="h-3 w-3 text-blue-500" />}
                </div>
              ))}
              {tablesInCategory.length > 3 && (
                <div className="text-center text-sm text-gray-500">
                  +{tablesInCategory.length - 3} more tables
                </div>
              )}
            </div>
          </div>
        </CardContent>
        <CardFooter className="border-t border-gray-100 pt-4">
          <Button
            variant="ghost"
            size="sm"
            className="w-full group"
            onClick={(e) => {
              e.stopPropagation();
              setSelectedCategory(category.id);
              setActiveTab("tables");
            }}
          >
            <span>Explore Category</span>
            <ChevronRight className="ml-2 h-4 w-4 group-hover:translate-x-1 transition-transform" />
          </Button>
        </CardFooter>
      </Card>
    );
  };

  // Render table row in list view
  const TableRowItem = ({ table }: { table: (typeof ALL_TABLES)[0] }) => {
    const category = EXPERT_CATEGORIES.find((c) => c.id === table.category);

    return (
      <div
        className={`flex items-center justify-between p-4 rounded-xl border hover:shadow-lg transition-all duration-200 cursor-pointer group ${
          selectedTable === table.name
            ? "border-indigo-300 bg-gradient-to-r from-indigo-50/50 to-purple-50/50"
            : "border-gray-200 hover:border-indigo-200 bg-white"
        }`}
        onClick={() => setSelectedTable(table.name)}
      >
        <div className="flex items-center gap-4">
          <div className="flex flex-col items-center">
            <div className="text-2xl">{table.icon}</div>
            {table.is_view === true && (
              <Badge className="mt-1 text-xs" variant="secondary">
                VIEW
              </Badge>
            )}
          </div>

          <div className="flex-1">
            <div className="flex items-center gap-2">
              <h4 className="font-semibold text-gray-900">
                {table.displayName}
              </h4>
              <Badge
                variant={
                  table.importance === "critical"
                    ? "destructive"
                    : table.importance === "high"
                      ? "default"
                      : "secondary"
                }
                className="text-xs"
              >
                {table.importance?.toUpperCase() || "N/A"}
              </Badge>
            </div>
            <p className="text-sm text-gray-600 mt-1">{table.description}</p>
            <div className="flex items-center gap-3 mt-2">
              <Badge variant="outline" className="text-xs">
                <Table2 className="h-3 w-3 mr-1" />
                {table.columns ?? 0} columns
              </Badge>
              <Badge variant="outline" className="text-xs">
                <Rows className="h-3 w-3 mr-1" />
                {formatNumber(table.rowCount ?? 0)} rows
              </Badge>
              {table.hasFK && (
                <Badge variant="outline" className="text-xs">
                  <Link2 className="h-3 w-3 mr-1" />
                  Foreign Keys
                </Badge>
              )}
              {table.tags?.slice(0, 2).map((tag) => (
                <Badge key={tag} variant="secondary" className="text-xs">
                  {tag}
                </Badge>
              ))}
            </div>
          </div>
        </div>

        <div className="flex items-center gap-3">
          <div className="flex gap-2">
            <TooltipProvider>
              <Tooltip>
                <TooltipTrigger asChild>
                  <Button
                    size="sm"
                    variant="outline"
                    onClick={(e) => {
                      e.stopPropagation();
                      handleViewData(table);
                    }}
                    className="h-8 w-8 p-0"
                  >
                    <Eye className="h-4 w-4" />
                  </Button>
                </TooltipTrigger>
                <TooltipContent>
                  <p>View Data</p>
                </TooltipContent>
              </Tooltip>
            </TooltipProvider>

            <TooltipProvider>
              <Tooltip>
                <TooltipTrigger asChild>
                  <Button
                    size="sm"
                    variant="outline"
                    onClick={(e) => {
                      e.stopPropagation();
                      handleAddRecord(table);
                    }}
                    className="h-8 w-8 p-0"
                  >
                    <Plus className="h-4 w-4" />
                  </Button>
                </TooltipTrigger>
                <TooltipContent>
                  <p>Add Record</p>
                </TooltipContent>
              </Tooltip>
            </TooltipProvider>

            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <Button
                  size="sm"
                  variant="outline"
                  className="h-8 w-8 p-0"
                  onClick={(e) => e.stopPropagation()}
                >
                  <MoreVertical className="h-4 w-4" />
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end">
                <DropdownMenuLabel>Actions</DropdownMenuLabel>
                <DropdownMenuItem
                  onClick={() => handleExportData(table.name, "csv")}
                >
                  <FileDown className="h-4 w-4 mr-2" />
                  Export CSV
                </DropdownMenuItem>
                <DropdownMenuItem
                  onClick={() => handleExportData(table.name, "json")}
                >
                  <Braces className="h-4 w-4 mr-2" />
                  Export JSON
                </DropdownMenuItem>
                <DropdownMenuItem onClick={() => handleImportData(table.name)}>
                  <FileUp className="h-4 w-4 mr-2" />
                  Import Data
                </DropdownMenuItem>
                <DropdownMenuSeparator />
                <DropdownMenuItem
                  onClick={() => handleCopyToClipboard(table.name)}
                >
                  <Copy className="h-4 w-4 mr-2" />
                  Copy Table Name
                </DropdownMenuItem>
              </DropdownMenuContent>
            </DropdownMenu>
          </div>
          <div className="text-right">
            <div className="font-semibold text-gray-900">
              {formatSize((table.sizeMB ?? 0) * 1024 * 1024)}
            </div>
            <div className="text-xs text-gray-500">Size</div>
          </div>
          <ChevronRight className="h-5 w-5 text-gray-400 group-hover:text-indigo-500 group-hover:translate-x-1 transition-all" />
        </div>
      </div>
    );
  };

  // Render table in grid view
  const TableGridItem = ({ table }: { table: (typeof ALL_TABLES)[0] }) => {
    const category = EXPERT_CATEGORIES.find((c) => c.id === table.category);

    return (
      <Card
        className={`group cursor-pointer border-0 shadow-md hover:shadow-xl transition-all duration-300 hover:scale-[1.02] overflow-hidden ${
          selectedTable === table.name ? "ring-2 ring-indigo-500" : ""
        }`}
        onClick={() => setSelectedTable(table.name)}
      >
        <CardHeader className="pb-3">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2">
              <div className="text-2xl">{table.icon}</div>
              <div>
                <CardTitle className="text-sm font-semibold">
                  {table.displayName}
                </CardTitle>
                <CardDescription className="text-xs">
                  {table.name}
                </CardDescription>
              </div>
            </div>
            {table.is_view === true && (
              <Badge variant="secondary" className="text-xs">
                VIEW
              </Badge>
            )}
          </div>
        </CardHeader>
        <CardContent className="pb-3">
          <p className="text-xs text-gray-600 mb-3 line-clamp-2">
            {table.description}
          </p>
          <div className="space-y-2">
            <div className="flex justify-between text-xs">
              <span className="text-gray-500">Rows:</span>
              <span className="font-medium">
                {formatNumber(table.rowCount ?? 0)}
              </span>
            </div>
            <div className="flex justify-between text-xs">
              <span className="text-gray-500">Size:</span>
              <span className="font-medium">
                {formatSize((table.sizeMB ?? 0) * 1024 * 1024)}
              </span>
            </div>
            <div className="flex justify-between text-xs">
              <span className="text-gray-500">Columns:</span>
              <span className="font-medium">{table.columns ?? 0}</span>
            </div>
          </div>
          {table.tags && table.tags.length > 0 && (
            <div className="mt-3 flex flex-wrap gap-1">
              {table.tags.slice(0, 2).map((tag) => (
                <Badge key={tag} variant="outline" className="text-xs">
                  {tag}
                </Badge>
              ))}
            </div>
          )}
        </CardContent>
        <CardFooter className="pt-0 flex gap-2">
          <TooltipProvider>
            <Tooltip>
              <TooltipTrigger asChild>
                <Button
                  size="sm"
                  variant="outline"
                  className="h-8 flex-1"
                  onClick={(e) => {
                    e.stopPropagation();
                    handleViewData(table);
                  }}
                >
                  <Eye className="h-3 w-3" />
                </Button>
              </TooltipTrigger>
              <TooltipContent>
                <p>View Data</p>
              </TooltipContent>
            </Tooltip>
          </TooltipProvider>
          <TooltipProvider>
            <Tooltip>
              <TooltipTrigger asChild>
                <Button
                  size="sm"
                  variant="outline"
                  className="h-8 flex-1"
                  onClick={(e) => {
                    e.stopPropagation();
                    handleAddRecord(table);
                  }}
                >
                  <Plus className="h-3 w-3" />
                </Button>
              </TooltipTrigger>
              <TooltipContent>
                <p>Add Record</p>
              </TooltipContent>
            </Tooltip>
          </TooltipProvider>
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <Button
                size="sm"
                variant="outline"
                className="h-8 w-8 p-0"
                onClick={(e) => e.stopPropagation()}
              >
                <MoreVertical className="h-3 w-3" />
              </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent align="end">
              <DropdownMenuItem
                onClick={() => handleExportData(table.name, "csv")}
              >
                <FileDown className="h-4 w-4 mr-2" />
                Export CSV
              </DropdownMenuItem>
              <DropdownMenuItem
                onClick={() => handleExportData(table.name, "json")}
              >
                <Braces className="h-4 w-4 mr-2" />
                Export JSON
              </DropdownMenuItem>
              <DropdownMenuItem
                onClick={() => handleCopyToClipboard(table.name)}
              >
                <Copy className="h-4 w-4 mr-2" />
                Copy Name
              </DropdownMenuItem>
            </DropdownMenuContent>
          </DropdownMenu>
        </CardFooter>
      </Card>
    );
  };

  // Quick stats cards
  const StatCard = ({ title, value, icon: Icon, trend, color }: any) => (
    <Card className="border-0 shadow-sm bg-gradient-to-br from-white to-gray-50/50 overflow-hidden">
      <CardContent className="p-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="text-sm font-medium text-gray-600">{title}</p>
            <p className="text-2xl font-bold text-gray-900 mt-1">{value}</p>
            {trend && (
              <div className="flex items-center gap-1 mt-2">
                <TrendingUp
                  className={`h-4 w-4 ${
                    trend > 0 ? "text-emerald-500" : "text-rose-500"
                  }`}
                />
                <span
                  className={`text-sm ${
                    trend > 0 ? "text-emerald-600" : "text-rose-600"
                  }`}
                >
                  {trend > 0 ? "+" : ""}
                  {trend}%
                </span>
              </div>
            )}
          </div>
          <div className={`p-3 rounded-full ${color} bg-opacity-10`}>
            <Icon className={`h-6 w-6 ${color.replace("bg-", "text-")}`} />
          </div>
        </div>
      </CardContent>
    </Card>
  );

  return (
    <div className="min-h-screen bg-gradient-to-br from-gray-50 via-white to-indigo-50/20">
      {/* Top Navigation Bar */}
      <div className="sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-gray-200/80 shadow-lg">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <Button
                variant="ghost"
                size="sm"
                className="lg:hidden"
                onClick={() => setShowMobileMenu(true)}
              >
                <Menu className="h-5 w-5" />
              </Button>

              <Link href="/dashboard">
                <Button
                  variant="ghost"
                  size="sm"
                  className="gap-2 text-gray-600 hover:text-gray-900"
                >
                  <Home className="h-4 w-4" />
                  Home
                </Button>
              </Link>

              <div className="hidden lg:flex items-center gap-3">
                <div className="p-2 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-xl shadow-md">
                  <DatabaseZap className="h-5 w-5 text-white" />
                </div>
                <div>
                  <h1 className="text-xl font-bold bg-gradient-to-r from-gray-900 to-indigo-800 bg-clip-text text-transparent">
                    Database Admin Portal
                  </h1>
                  <div className="flex items-center gap-2">
                    <code className="text-xs font-mono text-gray-500">
                      {DB_CONFIG.database}
                    </code>
                    <ConnectionStatusBadge />
                  </div>
                </div>
              </div>
            </div>

            {/* Right side actions */}
            <div className="flex items-center gap-3">
              <TooltipProvider>
                <Tooltip>
                  <TooltipTrigger asChild>
                    <Button
                      variant="ghost"
                      size="icon"
                      className="relative"
                      onClick={() => setShowNotifications(!showNotifications)}
                    >
                      <Bell className="h-5 w-5" />
                      {notifications.filter((n) => !n.read).length > 0 && (
                        <span className="absolute -top-1 -right-1 h-2 w-2 bg-rose-500 rounded-full" />
                      )}
                    </Button>
                  </TooltipTrigger>
                  <TooltipContent>
                    <p>Notifications</p>
                  </TooltipContent>
                </Tooltip>
              </TooltipProvider>

              <TooltipProvider>
                <Tooltip>
                  <TooltipTrigger asChild>
                    <Button
                      variant="ghost"
                      size="icon"
                      onClick={() => setShowQueryEditor(true)}
                    >
                      <Terminal className="h-5 w-5" />
                    </Button>
                  </TooltipTrigger>
                  <TooltipContent>
                    <p>SQL Query Editor</p>
                  </TooltipContent>
                </Tooltip>
              </TooltipProvider>

              <TooltipProvider>
                <Tooltip>
                  <TooltipTrigger asChild>
                    <Button
                      variant="ghost"
                      size="icon"
                      onClick={() => refetchTables()}
                    >
                      <RefreshCw className="h-5 w-5" />
                    </Button>
                  </TooltipTrigger>
                  <TooltipContent>
                    <p>Refresh Data</p>
                  </TooltipContent>
                </Tooltip>
              </TooltipProvider>

              <Separator orientation="vertical" className="h-6" />

              <DropdownMenu open={showUserMenu} onOpenChange={setShowUserMenu}>
                <DropdownMenuTrigger asChild>
                  <Button variant="ghost" className="gap-2">
                    <div className="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-white font-semibold">
                      A
                    </div>
                    <div className="hidden md:block text-left">
                      <div className="text-sm font-medium">Admin User</div>
                      <div className="text-xs text-gray-500">Administrator</div>
                    </div>
                    <ChevronRight className="h-4 w-4 hidden md:block" />
                  </Button>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="end" className="w-56">
                  <DropdownMenuLabel>My Account</DropdownMenuLabel>
                  <DropdownMenuSeparator />
                  <DropdownMenuItem>
                    <User className="h-4 w-4 mr-2" />
                    Profile
                  </DropdownMenuItem>
                  <DropdownMenuItem>
                    <Settings className="h-4 w-4 mr-2" />
                    Settings
                  </DropdownMenuItem>
                  <DropdownMenuSeparator />
                  <DropdownMenuItem>
                    <LogOut className="h-4 w-4 mr-2" />
                    Logout
                  </DropdownMenuItem>
                </DropdownMenuContent>
              </DropdownMenu>
            </div>
          </div>
        </div>

        {/* Notifications Dropdown */}
        {showNotifications && (
          <div className="absolute right-4 top-16 w-80 bg-white rounded-xl shadow-2xl border border-gray-200 z-50">
            <div className="p-4 border-b border-gray-100">
              <div className="flex items-center justify-between">
                <h3 className="font-semibold text-gray-900">Notifications</h3>
                <div className="flex items-center gap-2">
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={handleMarkAllAsRead}
                    className="text-xs"
                  >
                    Mark all as read
                  </Button>
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={() => setShowNotifications(false)}
                    className="h-8 w-8 p-0"
                  >
                    <X className="h-4 w-4" />
                  </Button>
                </div>
              </div>
            </div>
            <ScrollArea className="h-96">
              {notifications.length === 0 ? (
                <div className="p-8 text-center text-gray-500">
                  <Bell className="h-12 w-12 mx-auto mb-4 text-gray-300" />
                  <p>No notifications</p>
                </div>
              ) : (
                notifications.map((notification) => (
                  <div
                    key={notification.id}
                    className={`p-4 border-b border-gray-100 hover:bg-gray-50 cursor-pointer ${
                      !notification.read ? "bg-blue-50/50" : ""
                    }`}
                  >
                    <div className="flex items-start gap-3">
                      <div
                        className={`p-2 rounded-full ${
                          notification.type === "success"
                            ? "bg-emerald-100 text-emerald-600"
                            : notification.type === "warning"
                              ? "bg-amber-100 text-amber-600"
                              : notification.type === "error"
                                ? "bg-rose-100 text-rose-600"
                                : "bg-blue-100 text-blue-600"
                        }`}
                      >
                        {notification.type === "success" ? (
                          <CheckCircle className="h-4 w-4" />
                        ) : notification.type === "warning" ? (
                          <AlertTriangle className="h-4 w-4" />
                        ) : notification.type === "error" ? (
                          <XCircle className="h-4 w-4" />
                        ) : (
                          <Info className="h-4 w-4" />
                        )}
                      </div>
                      <div className="flex-1">
                        <div className="flex items-center justify-between">
                          <h4 className="font-medium text-gray-900">
                            {notification.title}
                          </h4>
                          {!notification.read && (
                            <div className="h-2 w-2 bg-blue-500 rounded-full" />
                          )}
                        </div>
                        <p className="text-sm text-gray-600 mt-1">
                          {notification.description}
                        </p>
                        <p className="text-xs text-gray-400 mt-2">
                          {notification.time}
                        </p>
                      </div>
                    </div>
                  </div>
                ))
              )}
            </ScrollArea>
            <div className="p-4 border-t border-gray-100">
              <Button
                variant="outline"
                className="w-full"
                onClick={handleClearNotifications}
              >
                Clear All Notifications
              </Button>
            </div>
          </div>
        )}
      </div>

      {/* Main Content */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {/* Quick Stats Bar */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <StatCard
            title="Total Tables"
            value={ALL_TABLES.length}
            icon={Table2}
            trend={2.5}
            color="bg-indigo-500"
          />
          <StatCard
            title="Total Records"
            value={formatNumber(
              ALL_TABLES.reduce((sum, t) => sum + t.rowCount, 0),
            )}
            icon={Database}
            trend={5.2}
            color="bg-emerald-500"
          />
          <StatCard
            title="Database Size"
            value={formatSize(
              ALL_TABLES.reduce((sum, t) => sum + t.sizeMB, 0) * 1024 * 1024,
            )}
            icon={HardDrive}
            trend={-1.3}
            color="bg-amber-500"
          />
          <StatCard
            title="Active Connections"
            value={databaseHealth?.database?.connections || 0}
            icon={Users}
            trend={12.7}
            color="bg-cyan-500"
          />
        </div>

        {/* Database Status Card */}
        <Card className="mb-6 border-0 shadow-lg bg-gradient-to-br from-white to-indigo-50/30 overflow-hidden">
          <div className="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500" />
          <CardContent className="p-6">
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6">
              <div className="flex items-center gap-4">
                <div className="relative">
                  <div
                    className={`h-16 w-16 rounded-full flex items-center justify-center ${
                      connectionStatus === "connected"
                        ? "bg-gradient-to-br from-emerald-500 to-green-500"
                        : connectionStatus === "connecting"
                          ? "bg-gradient-to-br from-amber-500 to-orange-500"
                          : "bg-gradient-to-br from-rose-500 to-pink-500"
                    }`}
                  >
                    {connectionStatus === "connected" ? (
                      <CheckCircle className="h-8 w-8 text-white" />
                    ) : connectionStatus === "connecting" ? (
                      <Loader2 className="h-8 w-8 text-white animate-spin" />
                    ) : (
                      <XCircle className="h-8 w-8 text-white" />
                    )}
                  </div>
                  <div className="absolute -bottom-1 -right-1">
                    <div className="h-6 w-6 rounded-full bg-white border-4 border-white flex items-center justify-center">
                      <Database className="h-3 w-3 text-gray-700" />
                    </div>
                  </div>
                </div>
                <div>
                  <h3 className="text-lg font-bold text-gray-900">
                    PostgreSQL Database
                  </h3>
                  <p className="text-sm text-gray-600">
                    {DB_CONFIG.host}:{DB_CONFIG.port} • {DB_CONFIG.user} •{" "}
                    {DB_CONFIG.database}
                  </p>
                  <div className="flex items-center gap-2 mt-1">
                    <span className="text-xs text-gray-500">Last sync:</span>
                    <span className="text-xs font-medium">
                      {getTimeSince(lastFetchTime)}
                    </span>
                  </div>
                </div>
              </div>

              <div className="flex flex-wrap gap-3">
                <Button
                  variant="outline"
                  size="sm"
                  onClick={handleTestConnection}
                  className="gap-2"
                >
                  <Wifi className="h-4 w-4" />
                  Test Connection
                </Button>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => setShowBackupModal(true)}
                  className="gap-2"
                >
                  <DatabaseBackup className="h-4 w-4" />
                  Backup
                </Button>
                <Button
                  variant="default"
                  size="sm"
                  className="gap-2 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700"
                  onClick={handleOptimizeDatabase}
                >
                  <Zap className="h-4 w-4" />
                  Optimize
                </Button>
              </div>
            </div>
          </CardContent>
        </Card>

        {/* Main Navigation Tabs */}
        <Tabs value={activeTab} onValueChange={setActiveTab} className="mb-8">
          <TabsList className="grid grid-cols-6 mb-6 bg-gray-100/80 p-1.5 rounded-2xl border border-gray-200">
            <TabsTrigger
              value="dashboard"
              className="gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-indigo-500 data-[state=active]:to-purple-500 data-[state=active]:text-white rounded-xl"
            >
              <LayoutDashboard className="h-4 w-4" />
              Dashboard
            </TabsTrigger>
            <TabsTrigger
              value="tables"
              className="gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-emerald-500 data-[state=active]:to-green-500 data-[state=active]:text-white rounded-xl"
            >
              <Table2 className="h-4 w-4" />
              Tables ({filteredTables.length})
            </TabsTrigger>
            <TabsTrigger
              value="query"
              className="gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-pink-500 data-[state=active]:to-rose-500 data-[state=active]:text-white rounded-xl"
            >
              <Play className="h-4 w-4" />
              Query Console
            </TabsTrigger>
            <TabsTrigger
              value="analytics"
              className="gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-cyan-500 data-[state=active]:to-blue-500 data-[state=active]:text-white rounded-xl"
            >
              <BarChart3 className="h-4 w-4" />
              Analytics
            </TabsTrigger>
            <TabsTrigger
              value="backups"
              className="gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-amber-500 data-[state=active]:to-orange-500 data-[state=active]:text-white rounded-xl"
            >
              <DatabaseBackup className="h-4 w-4" />
              Backups
            </TabsTrigger>
            <TabsTrigger
              value="settings"
              className="gap-2 data-[state=active]:bg-gradient-to-r data-[state=active]:from-gray-700 data-[state=active]:to-gray-900 data-[state=active]:text-white rounded-xl"
            >
              <Settings className="h-4 w-4" />
              Settings
            </TabsTrigger>
          </TabsList>

          {/* Dashboard Tab */}
          <TabsContent value="dashboard" className="space-y-6">
            <div>
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h2 className="text-2xl font-bold text-gray-900">
                    Database Overview
                  </h2>
                  <p className="text-gray-600">
                    Organized by functional domains with real-time statistics
                  </p>
                </div>
                <div className="flex items-center gap-3">
                  <div className="flex items-center gap-2">
                    <Switch
                      checked={autoRefresh}
                      onCheckedChange={setAutoRefresh}
                    />
                    <Label className="text-sm">Auto Refresh</Label>
                  </div>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => refetchTables()}
                    className="gap-2"
                  >
                    <RefreshCw className="h-4 w-4" />
                    Refresh
                  </Button>
                </div>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {EXPERT_CATEGORIES.map((category) => (
                  <CategoryCard key={category.id} category={category} />
                ))}
              </div>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* Quick Actions */}
              <Card className="lg:col-span-2 border-0 shadow-lg">
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <Zap className="h-5 w-5" />
                    Quick Operations
                  </CardTitle>
                  <CardDescription>
                    One-click database management
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <div className="grid grid-cols-2 gap-4">
                    <Button
                      variant="outline"
                      className="justify-start gap-3 h-auto py-4 hover:bg-indigo-50 hover:border-indigo-200"
                      onClick={() => setShowQueryEditor(true)}
                    >
                      <Terminal className="h-5 w-5" />
                      <div className="text-left">
                        <div className="font-medium">SQL Editor</div>
                        <div className="text-xs text-gray-500">
                          Run custom queries
                        </div>
                      </div>
                    </Button>

                    <Button
                      variant="outline"
                      className="justify-start gap-3 h-auto py-4 hover:bg-emerald-50 hover:border-emerald-200"
                      onClick={() => setShowBackupModal(true)}
                    >
                      <DatabaseBackup className="h-5 w-5" />
                      <div className="text-left">
                        <div className="font-medium">Create Backup</div>
                        <div className="text-xs text-gray-500">
                          Full/Partial backup
                        </div>
                      </div>
                    </Button>

                    <Button
                      variant="outline"
                      className="justify-start gap-3 h-auto py-4 hover:bg-amber-50 hover:border-amber-200"
                      onClick={handleOptimizeDatabase}
                    >
                      <Zap className="h-5 w-5" />
                      <div className="text-left">
                        <div className="font-medium">Optimize DB</div>
                        <div className="text-xs text-gray-500">
                          Performance tuning
                        </div>
                      </div>
                    </Button>

                    <Button
                      variant="outline"
                      className="justify-start gap-3 h-auto py-4 hover:bg-cyan-50 hover:border-cyan-200"
                      onClick={() => setShowSettingsModal(true)}
                    >
                      <Settings className="h-5 w-5" />
                      <div className="text-left">
                        <div className="font-medium">Settings</div>
                        <div className="text-xs text-gray-500">
                          Database config
                        </div>
                      </div>
                    </Button>
                  </div>
                </CardContent>
              </Card>

              {/* Recent Activity */}
              <Card className="border-0 shadow-lg">
                <CardHeader>
                  <CardTitle className="flex items-center gap-2">
                    <History className="h-5 w-5" />
                    Recent Queries
                  </CardTitle>
                  <CardDescription>
                    Recently executed SQL queries
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <ScrollArea className="h-64">
                    <div className="space-y-3">
                      {RECENT_QUERIES.map((query) => (
                        <div
                          key={query.id}
                          className="p-3 rounded-lg border border-gray-200 hover:bg-gray-50"
                        >
                          <div className="flex items-center justify-between mb-2">
                            <code className="text-xs font-mono bg-gray-100 px-2 py-1 rounded">
                              {query.duration}ms
                            </code>
                            <span className="text-xs text-gray-500">
                              {query.rows} rows
                            </span>
                          </div>
                          <p className="text-sm font-mono text-gray-700 truncate">
                            {query.query}
                          </p>
                          <p className="text-xs text-gray-400 mt-1">
                            {query.executed_at}
                          </p>
                        </div>
                      ))}
                    </div>
                  </ScrollArea>
                </CardContent>
              </Card>
            </div>
          </TabsContent>

          {/* Tables Tab */}
          <TabsContent value="tables" className="space-y-6">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <h2 className="text-2xl font-bold text-gray-900">
                  Database Tables
                </h2>
                <p className="text-gray-600">
                  Browse and manage all database tables
                </p>
              </div>

              <div className="flex flex-col sm:flex-row gap-3">
                <div className="relative flex-1 sm:w-64">
                  <Search className="absolute left-3 top-3 h-4 w-4 text-gray-400" />
                  <Input
                    placeholder="Search tables..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    className="pl-9"
                  />
                </div>

                <div className="flex items-center gap-2">
                  <Button
                    variant={viewMode === "grid" ? "default" : "outline"}
                    size="icon"
                    onClick={() => setViewMode("grid")}
                    className="h-9 w-9"
                  >
                    <Grid className="h-4 w-4" />
                  </Button>
                  <Button
                    variant={viewMode === "list" ? "default" : "outline"}
                    size="icon"
                    onClick={() => setViewMode("list")}
                    className="h-9 w-9"
                  >
                    <List className="h-4 w-4" />
                  </Button>
                </div>

                <Select
                  value={selectedCategory}
                  onValueChange={setSelectedCategory}
                >
                  <SelectTrigger className="w-full sm:w-48">
                    <SelectValue placeholder="Filter by category" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="all">All Categories</SelectItem>
                    {EXPERT_CATEGORIES.map((category) => (
                      <SelectItem key={category.id} value={category.id}>
                        {category.name}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
            </div>

            {/* Category Filter Pills */}
            <ScrollArea className="w-full">
              <div className="flex gap-2 pb-2">
                <Button
                  variant={selectedCategory === "all" ? "default" : "outline"}
                  size="sm"
                  onClick={() => setSelectedCategory("all")}
                  className="whitespace-nowrap"
                >
                  All Tables ({ALL_TABLES.length})
                </Button>
                {EXPERT_CATEGORIES.map((category) => (
                  <Button
                    key={category.id}
                    variant={
                      selectedCategory === category.id ? "default" : "outline"
                    }
                    size="sm"
                    className="gap-2 whitespace-nowrap"
                    onClick={() => setSelectedCategory(category.id)}
                  >
                    <category.icon className="h-3 w-3" />
                    {category.name} ({categoryStats[category.id]?.tables || 0})
                  </Button>
                ))}
                {selectedCategory !== "all" && (
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={() => setSelectedCategory("all")}
                    className="gap-2"
                  >
                    <FilterX className="h-3 w-3" />
                    Clear Filter
                  </Button>
                )}
              </div>
            </ScrollArea>

            {/* Tables Grid/List */}
            {filteredTables.length === 0 ? (
              <Card className="text-center py-12 border-0 shadow-lg">
                <Search className="h-12 w-12 mx-auto text-gray-300 mb-4" />
                <h3 className="text-lg font-semibold text-gray-700 mb-2">
                  No tables found
                </h3>
                <p className="text-gray-500 mb-4">
                  Try adjusting your search or filter criteria
                </p>
                <Button
                  variant="outline"
                  onClick={() => {
                    setSearchQuery("");
                    setSelectedCategory("all");
                  }}
                  className="gap-2"
                >
                  <FilterX className="h-4 w-4" />
                  Clear Filters
                </Button>
              </Card>
            ) : viewMode === "grid" ? (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {filteredTables.map((table) => (
                  <TableGridItem key={table.name} table={table} />
                ))}
              </div>
            ) : (
              <div className="space-y-3">
                {filteredTables.map((table) => (
                  <TableRowItem key={table.name} table={table} />
                ))}
              </div>
            )}

            {/* Table Details Panel */}
            {selectedTable && (
              <Card className="mt-6 border-0 shadow-xl bg-gradient-to-br from-white to-indigo-50/30 overflow-hidden">
                <div className="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 to-purple-500" />
                <CardHeader className="bg-gradient-to-r from-indigo-50/50 to-purple-50/50">
                  <div className="flex items-center justify-between">
                    <CardTitle className="flex items-center gap-3">
                      <span className="text-2xl">
                        {ALL_TABLES.find((t) => t.name === selectedTable)?.icon}
                      </span>
                      <div>
                        <div className="text-gray-900">
                          {
                            ALL_TABLES.find((t) => t.name === selectedTable)
                              ?.displayName
                          }
                        </div>
                        <div className="text-sm text-gray-500">
                          {selectedTable}
                        </div>
                      </div>
                    </CardTitle>
                    <div className="flex items-center gap-2">
                      <Button
                        variant="outline"
                        size="sm"
                        onClick={() => setSelectedTable(null)}
                      >
                        Close
                      </Button>
                    </div>
                  </div>
                </CardHeader>
                <CardContent className="pt-6">
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                      <h4 className="font-semibold text-gray-900 mb-4">
                        Table Information
                      </h4>
                      <div className="space-y-4">
                        {[
                          {
                            label: "Description",
                            value: ALL_TABLES.find(
                              (t) => t.name === selectedTable,
                            )?.description,
                          },
                          {
                            label: "Category",
                            value: EXPERT_CATEGORIES.find(
                              (c) =>
                                c.id ===
                                ALL_TABLES.find((t) => t.name === selectedTable)
                                  ?.category,
                            )?.name,
                          },
                          {
                            label: "Importance",
                            value: ALL_TABLES.find(
                              (t) => t.name === selectedTable,
                            )?.importance,
                          },
                          {
                            label: "Row Count",
                            value: formatNumber(
                              ALL_TABLES.find((t) => t.name === selectedTable)
                                ?.rowCount || 0,
                            ),
                          },
                          {
                            label: "Table Size",
                            value: formatSize(
                              (ALL_TABLES.find((t) => t.name === selectedTable)
                                ?.sizeMB || 0) *
                                1024 *
                                1024,
                            ),
                          },
                          {
                            label: "Columns",
                            value: ALL_TABLES.find(
                              (t) => t.name === selectedTable,
                            )?.columns,
                          },
                        ].map((item, index) => (
                          <div
                            key={index}
                            className="flex justify-between items-center p-2 hover:bg-gray-50 rounded"
                          >
                            <span className="text-sm text-gray-600">
                              {item.label}
                            </span>
                            <span className="font-medium">{item.value}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                    <div>
                      <h4 className="font-semibold text-gray-900 mb-4">
                        Admin Actions
                      </h4>
                      <div className="space-y-3">
                        <Button
                          variant="default"
                          className="w-full justify-start gap-2 bg-gradient-to-r from-indigo-600 to-purple-600"
                          onClick={() =>
                            handleViewData(
                              ALL_TABLES.find((t) => t.name === selectedTable)!,
                            )
                          }
                        >
                          <Eye className="h-4 w-4" />
                          Browse Data
                        </Button>
                        <Button
                          variant="outline"
                          className="w-full justify-start gap-2"
                          onClick={() =>
                            handleAddRecord(
                              ALL_TABLES.find((t) => t.name === selectedTable)!,
                            )
                          }
                        >
                          <Plus className="h-4 w-4" />
                          Add New Record
                        </Button>
                        <div className="grid grid-cols-2 gap-2">
                          <Button
                            variant="outline"
                            size="sm"
                            className="gap-2"
                            onClick={() =>
                              handleExportData(selectedTable, "csv")
                            }
                          >
                            <FileDown className="h-4 w-4" />
                            CSV
                          </Button>
                          <Button
                            variant="outline"
                            size="sm"
                            className="gap-2"
                            onClick={() =>
                              handleExportData(selectedTable, "json")
                            }
                          >
                            <Braces className="h-4 w-4" />
                            JSON
                          </Button>
                        </div>
                        <Button
                          variant="outline"
                          className="w-full justify-start gap-2"
                          onClick={() => handleImportData(selectedTable)}
                        >
                          <Upload className="h-4 w-4" />
                          Import Data
                        </Button>
                        <Button
                          variant="outline"
                          className="w-full justify-start gap-2"
                          onClick={() => {
                            toast({
                              title: "Analysis Started",
                              description: "Analyzing table performance...",
                            });
                          }}
                        >
                          <BarChart className="h-4 w-4" />
                          Analyze Table
                        </Button>
                      </div>
                    </div>
                  </div>
                </CardContent>
              </Card>
            )}
          </TabsContent>

          {/* Query Console Tab */}
          <TabsContent value="query" className="space-y-6">
            <Card className="border-0 shadow-lg">
              <CardHeader>
                <div className="flex items-center justify-between">
                  <div>
                    <CardTitle className="flex items-center gap-2">
                      <Play className="h-5 w-5 text-pink-600" />
                      SQL Query Console
                    </CardTitle>
                    <CardDescription>
                      Execute SQL queries against the database
                    </CardDescription>
                  </div>
                  <Button
                    onClick={handleExecuteQuery}
                    disabled={isExecutingQuery || !sqlQuery.trim()}
                    className="gap-2 bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600"
                  >
                    {isExecutingQuery ? (
                      <>
                        <Loader2 className="h-4 w-4 animate-spin" />
                        Executing...
                      </>
                    ) : (
                      <>
                        <Play className="h-4 w-4" />
                        Execute Query
                      </>
                    )}
                  </Button>
                </div>
              </CardHeader>
              <CardContent className="space-y-4">
                {/* SQL Editor */}
                <div className="space-y-2">
                  <label className="text-sm font-medium text-gray-700">
                    SQL Query
                  </label>
                  <Textarea
                    value={sqlQuery}
                    onChange={(e) => setSqlQuery(e.target.value)}
                    placeholder="Enter your SQL query here...&#10;Example: SELECT * FROM users LIMIT 10"
                    className="font-mono text-sm min-h-[200px] bg-gray-50"
                    disabled={isExecutingQuery}
                  />
                  <div className="flex items-center gap-2 text-xs text-gray-500">
                    <AlertCircle className="h-3 w-3" />
                    <span>
                      Execute SELECT queries to view data. Be careful with
                      UPDATE, DELETE, and DROP commands.
                    </span>
                  </div>
                </div>

                {/* Quick Templates */}
                <div className="space-y-2">
                  <label className="text-sm font-medium text-gray-700">
                    Quick Templates
                  </label>
                  <div className="flex flex-wrap gap-2">
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() =>
                        setSqlQuery(
                          "SELECT * FROM information_schema.tables WHERE table_schema = 'public';",
                        )
                      }
                      disabled={isExecutingQuery}
                    >
                      List All Tables
                    </Button>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() =>
                        setSqlQuery("SELECT * FROM users LIMIT 10;")
                      }
                      disabled={isExecutingQuery}
                    >
                      View Users
                    </Button>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() =>
                        setSqlQuery("SELECT * FROM businesses LIMIT 10;")
                      }
                      disabled={isExecutingQuery}
                    >
                      View Businesses
                    </Button>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() =>
                        setSqlQuery(
                          "SELECT table_name, pg_size_pretty(pg_total_relation_size(quote_ident(table_name)::regclass)) as size FROM information_schema.tables WHERE table_schema = 'public' ORDER BY pg_total_relation_size(quote_ident(table_name)::regclass) DESC;",
                        )
                      }
                      disabled={isExecutingQuery}
                    >
                      Table Sizes
                    </Button>
                    <Button
                      variant="outline"
                      size="sm"
                      onClick={() => setSqlQuery("")}
                      disabled={isExecutingQuery}
                    >
                      Clear
                    </Button>
                  </div>
                </div>

                {/* Query Results */}
                {queryResult && (
                  <div className="space-y-2">
                    <div className="flex items-center justify-between">
                      <label className="text-sm font-medium text-gray-700">
                        Query Results
                      </label>
                      <div className="flex items-center gap-4 text-xs text-gray-600">
                        <span className="flex items-center gap-1">
                          <CheckCircle className="h-3 w-3 text-green-600" />
                          {queryResult.rowCount} rows
                        </span>
                        <span className="flex items-center gap-1">
                          <Clock className="h-3 w-3 text-blue-600" />
                          {queryResult.duration}ms
                        </span>
                      </div>
                    </div>

                    {queryResult.success && queryResult.data.length > 0 ? (
                      <div className="border rounded-lg overflow-hidden">
                        <div className="overflow-x-auto max-h-[400px]">
                          <table className="w-full text-sm">
                            <thead className="bg-gray-100 border-b sticky top-0">
                              <tr>
                                {queryResult.columns.map((col) => (
                                  <th
                                    key={col}
                                    className="px-4 py-2 text-left font-semibold text-gray-700"
                                  >
                                    {col}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody>
                              {queryResult.data.map((row, idx) => (
                                <tr
                                  key={idx}
                                  className="border-b hover:bg-gray-50"
                                >
                                  {queryResult.columns.map((col) => (
                                    <td
                                      key={col}
                                      className="px-4 py-2 text-gray-900"
                                    >
                                      {row[col] !== null &&
                                      row[col] !== undefined ? (
                                        typeof row[col] === "object" ? (
                                          JSON.stringify(row[col])
                                        ) : (
                                          String(row[col])
                                        )
                                      ) : (
                                        <span className="text-gray-400 italic">
                                          null
                                        </span>
                                      )}
                                    </td>
                                  ))}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    ) : queryResult.success && queryResult.data.length === 0 ? (
                      <div className="border rounded-lg p-8 text-center text-gray-500">
                        <Database className="h-12 w-12 mx-auto mb-2 text-gray-400" />
                        <p>Query executed successfully but returned no rows</p>
                      </div>
                    ) : (
                      <div className="border border-red-200 rounded-lg p-4 bg-red-50">
                        <div className="flex items-start gap-2 text-red-800">
                          <XCircle className="h-5 w-5 mt-0.5 flex-shrink-0" />
                          <div>
                            <p className="font-medium">Query Error</p>
                            <p className="text-sm mt-1">{queryResult.error}</p>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                )}

                {!queryResult && (
                  <div className="border-2 border-dashed rounded-lg p-8 text-center text-gray-500">
                    <Play className="h-12 w-12 mx-auto mb-2 text-gray-400" />
                    <p>Enter a SQL query and click Execute to see results</p>
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          {/* Analytics Tab */}
          <TabsContent value="analytics">
            <Card className="border-0 shadow-lg">
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <BarChart3 className="h-5 w-5" />
                  Database Analytics
                </CardTitle>
                <CardDescription>
                  Performance metrics and insights
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
                  <div className="space-y-6">
                    <div>
                      <h4 className="font-semibold text-gray-900 mb-4">
                        Storage Distribution
                      </h4>
                      <div className="space-y-4">
                        {EXPERT_CATEGORIES.map((category) => {
                          const stats = categoryStats[category.id];
                          const totalSize = Object.values(categoryStats).reduce(
                            (sum, s) => sum + s.size,
                            0,
                          );
                          const percentage = stats
                            ? (stats.size / totalSize) * 100
                            : 0;

                          return (
                            <div key={category.id} className="space-y-2">
                              <div className="flex justify-between">
                                <div className="flex items-center gap-2">
                                  <div
                                    className={`h-3 w-3 rounded-full ${category.gradient}`}
                                  />
                                  <span className="text-sm text-gray-600">
                                    {category.name}
                                  </span>
                                </div>
                                <span className="text-sm font-medium">
                                  {formatSize(stats?.size || 0)}
                                </span>
                              </div>
                              <Progress value={percentage} className="h-2" />
                            </div>
                          );
                        })}
                      </div>
                    </div>

                    <div>
                      <h4 className="font-semibold text-gray-900 mb-4">
                        Performance Metrics
                      </h4>
                      <div className="space-y-4">
                        <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                          <div className="flex items-center gap-2">
                            <Activity className="h-4 w-4 text-gray-400" />
                            <span className="text-sm text-gray-600">
                              Cache Hit Rate
                            </span>
                          </div>
                          <span className="font-semibold text-emerald-600">
                            98.7%
                          </span>
                        </div>
                        <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                          <div className="flex items-center gap-2">
                            <Timer className="h-4 w-4 text-gray-400" />
                            <span className="text-sm text-gray-600">
                              Average Query Time
                            </span>
                          </div>
                          <span className="font-semibold text-amber-600">
                            42ms
                          </span>
                        </div>
                        <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                          <div className="flex items-center gap-2">
                            <Users className="h-4 w-4 text-gray-400" />
                            <span className="text-sm text-gray-600">
                              Active Connections
                            </span>
                          </div>
                          <span className="font-semibold text-blue-600">
                            12
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="space-y-6">
                    <div>
                      <h4 className="font-semibold text-gray-900 mb-4">
                        Record Distribution
                      </h4>
                      <div className="space-y-4">
                        {EXPERT_CATEGORIES.map((category) => {
                          const stats = categoryStats[category.id];
                          const totalRows = Object.values(categoryStats).reduce(
                            (sum, s) => sum + s.rows,
                            0,
                          );
                          const percentage = stats
                            ? (stats.rows / totalRows) * 100
                            : 0;

                          return (
                            <div key={category.id} className="space-y-2">
                              <div className="flex justify-between">
                                <div className="flex items-center gap-2">
                                  <category.icon className="h-4 w-4 text-gray-400" />
                                  <span className="text-sm text-gray-600">
                                    {category.name}
                                  </span>
                                </div>
                                <span className="text-sm font-medium">
                                  {formatNumber(stats?.rows || 0)}
                                </span>
                              </div>
                              <ProgressBar
                                percent={percentage}
                                className="h-2"
                              />
                            </div>
                          );
                        })}
                      </div>
                    </div>

                    <div>
                      <h4 className="font-semibold text-gray-900 mb-4">
                        Database Health
                      </h4>
                      <div className="space-y-3">
                        <div className="flex items-center justify-between p-3 bg-gradient-to-r from-emerald-50 to-green-50 rounded-lg border border-emerald-100">
                          <div className="flex items-center gap-2">
                            <ShieldCheck className="h-4 w-4 text-emerald-600" />
                            <span className="text-sm text-gray-700">
                              Connection Status
                            </span>
                          </div>
                          <Badge
                            variant="default"
                            className="bg-emerald-100 text-emerald-800 hover:bg-emerald-100"
                          >
                            {connectionStatus.toUpperCase()}
                          </Badge>
                        </div>
                        <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                          <div className="flex items-center gap-2">
                            <Clock className="h-4 w-4 text-gray-400" />
                            <span className="text-sm text-gray-600">
                              Uptime
                            </span>
                          </div>
                          <span className="text-sm font-medium">
                            15 days, 7:32:10
                          </span>
                        </div>
                        <div className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                          <div className="flex items-center gap-2">
                            <Database className="h-4 w-4 text-gray-400" />
                            <span className="text-sm text-gray-600">
                              Database Version
                            </span>
                          </div>
                          <span className="text-sm font-mono">
                            PostgreSQL 14.5
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Backups Tab */}
          <TabsContent value="backups">
            <Card className="border-0 shadow-lg">
              <CardHeader>
                <div className="flex items-center justify-between">
                  <div>
                    <CardTitle className="flex items-center gap-2">
                      <DatabaseBackup className="h-5 w-5" />
                      Database Backups
                    </CardTitle>
                    <CardDescription>
                      Manage and restore database backups
                    </CardDescription>
                  </div>
                  <Button
                    onClick={() => setShowBackupModal(true)}
                    className="gap-2 bg-gradient-to-r from-emerald-600 to-green-600"
                  >
                    <DatabaseBackup className="h-4 w-4" />
                    New Backup
                  </Button>
                </div>
              </CardHeader>
              <CardContent>
                <div className="space-y-4">
                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <Card className="border-0 shadow-sm bg-gradient-to-br from-emerald-50 to-green-50">
                      <CardContent className="p-4">
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="text-sm font-medium text-gray-600">
                              Total Backups
                            </p>
                            <p className="text-2xl font-bold text-gray-900">
                              {SAMPLE_BACKUPS.length}
                            </p>
                          </div>
                          <DatabaseBackup className="h-8 w-8 text-emerald-500" />
                        </div>
                      </CardContent>
                    </Card>
                    <Card className="border-0 shadow-sm bg-gradient-to-br from-blue-50 to-cyan-50">
                      <CardContent className="p-4">
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="text-sm font-medium text-gray-600">
                              Total Size
                            </p>
                            <p className="text-2xl font-bold text-gray-900">
                              {formatFileSize(
                                SAMPLE_BACKUPS.reduce(
                                  (sum, b) => sum + b.size,
                                  0,
                                ),
                              )}
                            </p>
                          </div>
                          <HardDrive className="h-8 w-8 text-blue-500" />
                        </div>
                      </CardContent>
                    </Card>
                    <Card className="border-0 shadow-sm bg-gradient-to-br from-amber-50 to-orange-50">
                      <CardContent className="p-4">
                        <div className="flex items-center justify-between">
                          <div>
                            <p className="text-sm font-medium text-gray-600">
                              Last Backup
                            </p>
                            <p className="text-2xl font-bold text-gray-900">
                              {getTimeSince(
                                new Date(SAMPLE_BACKUPS[0]?.created_at),
                              )}
                            </p>
                          </div>
                          <Calendar className="h-8 w-8 text-amber-500" />
                        </div>
                      </CardContent>
                    </Card>
                  </div>

                  <div className="rounded-lg border border-gray-200 overflow-hidden">
                    <Table>
                      <TableHeader className="bg-gray-50">
                        <TableRow>
                          <TableHead>Filename</TableHead>
                          <TableHead>Type</TableHead>
                          <TableHead>Size</TableHead>
                          <TableHead>Created At</TableHead>
                          <TableHead>Status</TableHead>
                          <TableHead className="text-right">Actions</TableHead>
                        </TableRow>
                      </TableHeader>
                      <TableBody>
                        {SAMPLE_BACKUPS.map((backup) => (
                          <TableRow
                            key={backup.id}
                            className="hover:bg-gray-50"
                          >
                            <TableCell className="font-medium">
                              {backup.filename}
                            </TableCell>
                            <TableCell>
                              <Badge
                                variant={
                                  backup.type === "full"
                                    ? "default"
                                    : backup.type === "partial"
                                      ? "secondary"
                                      : "outline"
                                }
                              >
                                {backup.type}
                              </Badge>
                            </TableCell>
                            <TableCell>{formatFileSize(backup.size)}</TableCell>
                            <TableCell>{backup.created_at}</TableCell>
                            <TableCell>
                              <Badge
                                variant={
                                  backup.status === "completed"
                                    ? "default"
                                    : backup.status === "in_progress"
                                      ? "secondary"
                                      : "destructive"
                                }
                              >
                                {backup.status}
                              </Badge>
                            </TableCell>
                            <TableCell className="text-right">
                              <div className="flex justify-end gap-2">
                                <Button size="sm" variant="outline">
                                  <Download className="h-4 w-4" />
                                </Button>
                                <Button size="sm" variant="outline">
                                  <RotateCcw className="h-4 w-4" />
                                </Button>
                                <Button size="sm" variant="ghost">
                                  <Trash2 className="h-4 w-4" />
                                </Button>
                              </div>
                            </TableCell>
                          </TableRow>
                        ))}
                      </TableBody>
                    </Table>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Settings Tab */}
          <TabsContent value="settings">
            <Card className="border-0 shadow-lg">
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <Settings className="h-5 w-5" />
                  Database Settings
                </CardTitle>
                <CardDescription>
                  Configure database connection and preferences
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-8">
                  <div>
                    <h4 className="font-semibold text-gray-900 mb-4">
                      Connection Settings
                    </h4>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {[
                        { label: "Host", value: DB_CONFIG.host, icon: Server },
                        { label: "Port", value: DB_CONFIG.port, icon: Network },
                        {
                          label: "Database",
                          value: DB_CONFIG.database,
                          icon: Database,
                        },
                        {
                          label: "Username",
                          value: DB_CONFIG.user,
                          icon: User,
                        },
                      ].map((item, index) => (
                        <div key={index} className="space-y-2">
                          <Label className="text-sm font-medium">
                            {item.label}
                          </Label>
                          <div className="flex items-center gap-3 p-3 border rounded-lg bg-gray-50/50">
                            <item.icon className="h-4 w-4 text-gray-400" />
                            <code className="font-mono text-sm flex-1">
                              {item.value}
                            </code>
                            <Button
                              size="sm"
                              variant="ghost"
                              onClick={() =>
                                handleCopyToClipboard(item.value.toString())
                              }
                            >
                              <Copy className="h-3 w-3" />
                            </Button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>

                  <Separator />

                  <div>
                    <h4 className="font-semibold text-gray-900 mb-4">
                      Performance Settings
                    </h4>
                    <div className="space-y-4">
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="auto-refresh" className="font-medium">
                            Auto Refresh
                          </Label>
                          <p className="text-sm text-gray-500">
                            Automatically refresh data every 30 seconds
                          </p>
                        </div>
                        <Switch
                          id="auto-refresh"
                          checked={autoRefresh}
                          onCheckedChange={setAutoRefresh}
                        />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="data-preview" className="font-medium">
                            Show Data Preview
                          </Label>
                          <p className="text-sm text-gray-500">
                            Display preview of table data
                          </p>
                        </div>
                        <Switch id="data-preview" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="show-views" className="font-medium">
                            Include Views
                          </Label>
                          <p className="text-sm text-gray-500">
                            Show database views in table list
                          </p>
                        </div>
                        <Switch id="show-views" defaultChecked />
                      </div>
                      <Separator className="my-4" />
                      <div>
                        <Label className="font-medium mb-3 block">
                          Auto-Vacuum Frequency
                        </Label>
                        <div className="grid grid-cols-2 gap-3">
                          {["Never", "Daily", "Weekly", "Monthly"].map(
                            (freq) => (
                              <Button
                                key={freq}
                                variant="outline"
                                size="sm"
                                className="justify-start"
                              >
                                {freq}
                              </Button>
                            ),
                          )}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Query Timeout (seconds)
                        </Label>
                        <div className="flex items-center gap-3">
                          <input
                            type="range"
                            min="5"
                            max="300"
                            step="5"
                            defaultValue="60"
                            className="flex-1"
                          />
                          <span className="text-sm font-mono bg-gray-50 px-3 py-1 rounded border">
                            60s
                          </span>
                        </div>
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="index-optimization"
                            className="font-medium"
                          >
                            Auto Index Optimization
                          </Label>
                          <p className="text-sm text-gray-500">
                            Automatically optimize indexes on large tables
                          </p>
                        </div>
                        <Switch id="index-optimization" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="connection-pooling"
                            className="font-medium"
                          >
                            Connection Pooling
                          </Label>
                          <p className="text-sm text-gray-500">
                            Enable connection pooling for better performance
                          </p>
                        </div>
                        <Switch id="connection-pooling" defaultChecked />
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Max Connections
                        </Label>
                        <div className="flex items-center gap-3">
                          <input
                            type="range"
                            min="5"
                            max="100"
                            step="5"
                            defaultValue="20"
                            className="flex-1"
                          />
                          <span className="text-sm font-mono bg-gray-50 px-3 py-1 rounded border">
                            20
                          </span>
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Backup Schedule
                        </Label>
                        <div className="grid grid-cols-2 gap-3">
                          {["Hourly", "Daily", "Weekly", "Manual"].map(
                            (schedule) => (
                              <Button
                                key={schedule}
                                variant="outline"
                                size="sm"
                                className="justify-start"
                              >
                                {schedule}
                              </Button>
                            ),
                          )}
                        </div>
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="monitoring-alerts"
                            className="font-medium"
                          >
                            Performance Alerts
                          </Label>
                          <p className="text-sm text-gray-500">
                            Alert on slow queries and high resource usage
                          </p>
                        </div>
                        <Switch id="monitoring-alerts" defaultChecked />
                      </div>
                    </div>
                  </div>

                  <Separator />

                  <div>
                    <h4 className="font-semibold text-gray-900 mb-4">
                      Security Settings
                    </h4>
                    <div className="space-y-4">
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="audit-log" className="font-medium">
                            Audit Logging
                          </Label>
                          <p className="text-sm text-gray-500">
                            Log all database operations
                          </p>
                        </div>
                        <Switch id="audit-log" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="ssl-connection"
                            className="font-medium"
                          >
                            SSL Connection
                          </Label>
                          <p className="text-sm text-gray-500">
                            Use SSL for database connections
                          </p>
                        </div>
                        <Switch id="ssl-connection" defaultChecked />
                      </div>
                      <Separator className="my-4" />
                      <div>
                        <Label className="font-medium mb-3 block">
                          Default User Role
                        </Label>
                        <div className="flex gap-2">
                          {["Admin", "Editor", "Viewer", "Guest"].map(
                            (role) => (
                              <Button
                                key={role}
                                variant="outline"
                                size="sm"
                                className="justify-start"
                              >
                                {role}
                              </Button>
                            ),
                          )}
                        </div>
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="api-keys" className="font-medium">
                            API Key Management
                          </Label>
                          <p className="text-sm text-gray-500">
                            Enable API key authentication
                          </p>
                        </div>
                        <Switch id="api-keys" defaultChecked />
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          IP Whitelist
                        </Label>
                        <textarea
                          className="w-full min-h-[80px] p-3 border rounded-lg bg-white text-sm font-mono"
                          placeholder="Enter IP addresses, one per line&#10;e.g., 192.168.1.1&#10;127.0.0.1"
                          defaultValue="127.0.0.1"
                        />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="encryption" className="font-medium">
                            Data Encryption at Rest
                          </Label>
                          <p className="text-sm text-gray-500">
                            Encrypt sensitive data in database
                          </p>
                        </div>
                        <Switch id="encryption" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="audit-trail" className="font-medium">
                            Detailed Audit Trail
                          </Label>
                          <p className="text-sm text-gray-500">
                            Track user actions and data changes
                          </p>
                        </div>
                        <Switch id="audit-trail" defaultChecked />
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Password Policy
                        </Label>
                        <div className="space-y-2">
                          {[
                            { label: "Minimum 8 characters", id: "pwd-8" },
                            { label: "Require uppercase", id: "pwd-upper" },
                            { label: "Require numbers", id: "pwd-num" },
                            {
                              label: "Require special characters",
                              id: "pwd-special",
                            },
                          ].map((policy) => (
                            <div
                              key={policy.id}
                              className="flex items-center gap-2"
                            >
                              <input
                                type="checkbox"
                                defaultChecked
                                className="rounded border-gray-300"
                                id={policy.id}
                              />
                              <Label htmlFor={policy.id} className="text-sm">
                                {policy.label}
                              </Label>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>

                  <Separator />

                  <div>
                    <h4 className="font-semibold text-gray-900 mb-4">
                      Table View Preferences
                    </h4>
                    <div className="space-y-4">
                      <div>
                        <Label className="font-medium mb-3 block">
                          Visible Columns
                        </Label>
                        <div className="grid grid-cols-2 gap-3">
                          {[
                            "Name",
                            "Type",
                            "Columns",
                            "Size",
                            "Rows",
                            "Indexes",
                          ].map((column) => (
                            <div
                              key={column}
                              className="flex items-center gap-2"
                            >
                              <input
                                type="checkbox"
                                defaultChecked
                                className="rounded border-gray-300"
                                id={`col-${column}`}
                              />
                              <Label
                                htmlFor={`col-${column}`}
                                className="text-sm"
                              >
                                {column}
                              </Label>
                            </div>
                          ))}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Default Sort By
                        </Label>
                        <div className="flex gap-2">
                          {["Name", "Size", "Rows", "Importance"].map(
                            (sort) => (
                              <Button
                                key={sort}
                                variant="outline"
                                size="sm"
                                className="justify-start"
                              >
                                {sort}
                              </Button>
                            ),
                          )}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Rows Per Page
                        </Label>
                        <div className="flex gap-2">
                          {[10, 25, 50, 100].map((rows) => (
                            <Button key={rows} variant="outline" size="sm">
                              {rows}
                            </Button>
                          ))}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Auto Refresh Interval (seconds)
                        </Label>
                        <div className="flex items-center gap-3">
                          <input
                            type="range"
                            min="5"
                            max="300"
                            step="5"
                            defaultValue="30"
                            className="flex-1"
                          />
                          <span className="text-sm font-mono bg-gray-50 px-3 py-1 rounded border">
                            30s
                          </span>
                        </div>
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="highlight-important"
                            className="font-medium"
                          >
                            Highlight Important Tables
                          </Label>
                          <p className="text-sm text-gray-500">
                            Visually emphasize critical and high-priority tables
                          </p>
                        </div>
                        <Switch id="highlight-important" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="column-resize"
                            className="font-medium"
                          >
                            Resizable Columns
                          </Label>
                          <p className="text-sm text-gray-500">
                            Allow manual adjustment of column widths
                          </p>
                        </div>
                        <Switch id="column-resize" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label htmlFor="compact-view" className="font-medium">
                            Compact View
                          </Label>
                          <p className="text-sm text-gray-500">
                            Reduce spacing for more table data on screen
                          </p>
                        </div>
                        <Switch id="compact-view" />
                      </div>
                    </div>
                  </div>

                  <Separator />

                  <div>
                    <h4 className="font-semibold text-gray-900 mb-4">
                      System Settings
                    </h4>
                    <div className="space-y-4">
                      <div>
                        <Label className="font-medium mb-3 block">
                          Theme Appearance
                        </Label>
                        <div className="flex gap-2">
                          {["Light", "Dark", "Auto"].map((theme) => (
                            <Button
                              key={theme}
                              variant="outline"
                              size="sm"
                              className="justify-start"
                            >
                              {theme}
                            </Button>
                          ))}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Language
                        </Label>
                        <div className="flex gap-2">
                          {[
                            "English",
                            "Spanish",
                            "French",
                            "German",
                            "Chinese",
                          ].map((lang) => (
                            <Button key={lang} variant="outline" size="sm">
                              {lang}
                            </Button>
                          ))}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Timezone
                        </Label>
                        <input
                          type="text"
                          defaultValue="UTC"
                          className="w-full p-2 border rounded-lg text-sm"
                          placeholder="e.g., UTC, EST, PST"
                        />
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Date Format
                        </Label>
                        <div className="flex gap-2">
                          {["MM/DD/YYYY", "DD/MM/YYYY", "YYYY-MM-DD"].map(
                            (format) => (
                              <Button key={format} variant="outline" size="sm">
                                {format}
                              </Button>
                            ),
                          )}
                        </div>
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Data Export Format
                        </Label>
                        <div className="flex gap-2">
                          {["CSV", "JSON", "Excel", "XML"].map((format) => (
                            <Button key={format} variant="outline" size="sm">
                              {format}
                            </Button>
                          ))}
                        </div>
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="email-notifications"
                            className="font-medium"
                          >
                            Email Notifications
                          </Label>
                          <p className="text-sm text-gray-500">
                            Receive email alerts for important events
                          </p>
                        </div>
                        <Switch id="email-notifications" defaultChecked />
                      </div>
                      <div className="flex items-center justify-between p-3 bg-gray-50/50 rounded-lg">
                        <div>
                          <Label
                            htmlFor="push-notifications"
                            className="font-medium"
                          >
                            Push Notifications
                          </Label>
                          <p className="text-sm text-gray-500">
                            Browser push notifications for real-time alerts
                          </p>
                        </div>
                        <Switch id="push-notifications" defaultChecked />
                      </div>
                      <div>
                        <Label className="font-medium mb-3 block">
                          Notification Frequency
                        </Label>
                        <div className="flex gap-2">
                          {["Realtime", "Hourly", "Daily", "Weekly"].map(
                            (frequency) => (
                              <Button
                                key={frequency}
                                variant="outline"
                                size="sm"
                              >
                                {frequency}
                              </Button>
                            ),
                          )}
                        </div>
                      </div>
                    </div>
                  </div>

                  <div className="flex justify-end gap-3">
                    <Button
                      variant="outline"
                      onClick={() => setShowSettingsModal(true)}
                    >
                      Advanced Settings
                    </Button>
                    <Button className="bg-gradient-to-r from-indigo-600 to-purple-600">
                      <Save className="h-4 w-4 mr-2" />
                      Save Changes
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>

        {/* Floating Actions */}
        <div className="fixed bottom-6 right-6 flex flex-col gap-3">
          <TooltipProvider>
            <Tooltip>
              <TooltipTrigger asChild>
                <Button
                  size="icon"
                  className="rounded-full shadow-xl bg-gradient-to-br from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 h-12 w-12"
                  onClick={() =>
                    window.scrollTo({ top: 0, behavior: "smooth" })
                  }
                >
                  <ChevronUp className="h-5 w-5" />
                </Button>
              </TooltipTrigger>
              <TooltipContent side="left">
                <p>Scroll to top</p>
              </TooltipContent>
            </Tooltip>
          </TooltipProvider>

          <TooltipProvider>
            <Tooltip>
              <TooltipTrigger asChild>
                <Button
                  size="icon"
                  className="rounded-full shadow-xl h-12 w-12"
                  onClick={() => setShowQueryEditor(true)}
                >
                  <Terminal className="h-5 w-5" />
                </Button>
              </TooltipTrigger>
              <TooltipContent side="left">
                <p>SQL Query Editor</p>
              </TooltipContent>
            </Tooltip>
          </TooltipProvider>
        </div>
      </div>

      {/* Mobile Menu */}
      <Sheet open={showMobileMenu} onOpenChange={setShowMobileMenu}>
        <SheetContent side="left" className="w-80">
          <SheetHeader>
            <SheetTitle className="flex items-center gap-2">
              <DatabaseZap className="h-5 w-5" />
              Database Admin
            </SheetTitle>
            <SheetDescription>Navigation menu</SheetDescription>
          </SheetHeader>
          <div className="py-6">
            <nav className="space-y-2">
              {[
                { id: "dashboard", label: "Dashboard", icon: LayoutDashboard },
                { id: "tables", label: "Tables", icon: Table2 },
                { id: "analytics", label: "Analytics", icon: BarChart3 },
                { id: "backups", label: "Backups", icon: DatabaseBackup },
                { id: "settings", label: "Settings", icon: Settings },
              ].map((item) => (
                <Button
                  key={item.id}
                  variant={activeTab === item.id ? "default" : "ghost"}
                  className="w-full justify-start gap-3"
                  onClick={() => {
                    setActiveTab(item.id);
                    setShowMobileMenu(false);
                  }}
                >
                  <item.icon className="h-4 w-4" />
                  {item.label}
                </Button>
              ))}
            </nav>
            <Separator className="my-6" />
            <div className="space-y-2">
              <Button variant="ghost" className="w-full justify-start gap-3">
                <User className="h-4 w-4" />
                Profile
              </Button>
              <Button variant="ghost" className="w-full justify-start gap-3">
                <Settings className="h-4 w-4" />
                Settings
              </Button>
              <Button variant="ghost" className="w-full justify-start gap-3">
                <LogOut className="h-4 w-4" />
                Logout
              </Button>
            </div>
          </div>
        </SheetContent>
      </Sheet>

      {/* SQL Query Editor Modal */}
      <Dialog open={showQueryEditor} onOpenChange={setShowQueryEditor}>
        <DialogContent className="max-w-4xl max-h-[90vh] flex flex-col">
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              <Terminal className="h-5 w-5" />
              SQL Query Editor
            </DialogTitle>
            <DialogDescription>
              Execute custom SQL queries against the database
            </DialogDescription>
          </DialogHeader>
          <div className="flex-1 overflow-hidden flex flex-col gap-4">
            <div className="flex-1 flex flex-col">
              <Label htmlFor="sql-editor" className="mb-2">
                SQL Query
              </Label>
              <Textarea
                ref={queryEditorRef}
                id="sql-editor"
                value={sqlQuery}
                onChange={(e) => setSqlQuery(e.target.value)}
                className="flex-1 font-mono text-sm resize-none"
                placeholder="Enter your SQL query here..."
              />
            </div>

            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => setSqlQuery("SELECT * FROM users LIMIT 10")}
                >
                  Sample Query
                </Button>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => setSqlQuery("")}
                >
                  Clear
                </Button>
              </div>
              <Button
                onClick={handleExecuteQuery}
                disabled={isExecutingQuery}
                className="gap-2 bg-gradient-to-r from-emerald-600 to-green-600"
              >
                {isExecutingQuery ? (
                  <>
                    <Loader2 className="h-4 w-4 animate-spin" />
                    Executing...
                  </>
                ) : (
                  <>
                    <Play className="h-4 w-4" />
                    Execute Query
                  </>
                )}
              </Button>
            </div>

            {queryResult && (
              <div className="border rounded-lg overflow-hidden">
                <div className="bg-gray-50 px-4 py-2 border-b flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-medium">Query Results</span>
                    <Badge variant="outline">{queryResult.rowCount} rows</Badge>
                    <Badge variant="outline">{queryResult.duration}ms</Badge>
                  </div>
                  <div className="flex items-center gap-2">
                    <Button
                      size="sm"
                      variant="outline"
                      onClick={() =>
                        handleCopyToClipboard(
                          JSON.stringify(queryResult.data, null, 2),
                        )
                      }
                    >
                      <Copy className="h-3 w-3 mr-1" />
                      Copy Results
                    </Button>
                  </div>
                </div>
                <ScrollArea className="h-64">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        {queryResult.columns?.map((column) => (
                          <TableHead key={column}>{column}</TableHead>
                        ))}
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {queryResult.data?.slice(0, 50).map((row, idx) => (
                        <TableRow key={idx}>
                          {queryResult.columns?.map((column) => (
                            <TableCell
                              key={column}
                              className="max-w-xs truncate"
                            >
                              {typeof row[column] === "object"
                                ? JSON.stringify(row[column])
                                : String(row[column] || "-")}
                            </TableCell>
                          ))}
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </ScrollArea>
              </div>
            )}
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowQueryEditor(false)}>
              Close
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Backup Creation Modal */}
      <Dialog open={showBackupModal} onOpenChange={setShowBackupModal}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              <DatabaseBackup className="h-5 w-5" />
              Create Database Backup
            </DialogTitle>
            <DialogDescription>
              Choose backup type and options
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            <div className="space-y-2">
              <Label>Backup Type</Label>
              <div className="grid grid-cols-3 gap-2">
                {[
                  {
                    id: "full",
                    label: "Full",
                    description: "Complete database backup",
                  },
                  {
                    id: "partial",
                    label: "Partial",
                    description: "Selected tables only",
                  },
                  {
                    id: "schema",
                    label: "Schema",
                    description: "Structure only, no data",
                  },
                ].map((type) => (
                  <Button
                    key={type.id}
                    variant={backupType === type.id ? "default" : "outline"}
                    className="h-auto py-3 flex flex-col items-center justify-center"
                    onClick={() => setBackupType(type.id as any)}
                  >
                    <div className="font-medium">{type.label}</div>
                    <div className="text-xs text-gray-500 mt-1">
                      {type.description}
                    </div>
                  </Button>
                ))}
              </div>
            </div>

            <div className="space-y-2">
              <Label>Backup Name</Label>
              <Input
                placeholder={`${backupType}_backup_${
                  new Date().toISOString().split("T")[0]
                }`}
                defaultValue={`${backupType}_backup_${
                  new Date().toISOString().split("T")[0]
                }`}
              />
            </div>

            <div className="space-y-2">
              <Label>Compression</Label>
              <Select defaultValue="medium">
                <SelectTrigger>
                  <SelectValue placeholder="Select compression level" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="none">None (Fastest)</SelectItem>
                  <SelectItem value="low">Low</SelectItem>
                  <SelectItem value="medium">Medium (Recommended)</SelectItem>
                  <SelectItem value="high">High (Smallest)</SelectItem>
                </SelectContent>
              </Select>
            </div>

            <div className="flex items-center space-x-2">
              <Switch id="encrypt-backup" />
              <Label htmlFor="encrypt-backup">
                Encrypt backup with password
              </Label>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowBackupModal(false)}>
              Cancel
            </Button>
            <Button
              onClick={handleCreateBackup}
              className="bg-gradient-to-r from-emerald-600 to-green-600 gap-2"
            >
              <DatabaseBackup className="h-4 w-4" />
              Create Backup
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Settings Modal */}
      <Dialog open={showSettingsModal} onOpenChange={setShowSettingsModal}>
        <DialogContent className="max-w-2xl">
          <DialogHeader>
            <DialogTitle>Advanced Settings</DialogTitle>
            <DialogDescription>
              Configure advanced database settings
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-6">
            <Accordion type="single" collapsible className="w-full">
              <AccordionItem value="connection">
                <AccordionTrigger>Connection Settings</AccordionTrigger>
                <AccordionContent>
                  <div className="space-y-4">
                    <div className="grid grid-cols-2 gap-4">
                      <div className="space-y-2">
                        <Label>Connection Timeout (ms)</Label>
                        <Input type="number" defaultValue="30000" />
                      </div>
                      <div className="space-y-2">
                        <Label>Max Connections</Label>
                        <Input type="number" defaultValue="100" />
                      </div>
                    </div>
                    <div className="flex items-center space-x-2">
                      <Switch id="pooling" defaultChecked />
                      <Label htmlFor="pooling">Enable Connection Pooling</Label>
                    </div>
                  </div>
                </AccordionContent>
              </AccordionItem>

              <AccordionItem value="performance">
                <AccordionTrigger>Performance Settings</AccordionTrigger>
                <AccordionContent>
                  <div className="space-y-4">
                    <div className="space-y-2">
                      <Label>Query Cache Size (MB)</Label>
                      <Input type="number" defaultValue="256" />
                    </div>
                    <div className="space-y-2">
                      <Label>Maximum Query Time (ms)</Label>
                      <Input type="number" defaultValue="30000" />
                    </div>
                    <div className="flex items-center space-x-2">
                      <Switch id="query-logging" />
                      <Label htmlFor="query-logging">
                        Enable Query Logging
                      </Label>
                    </div>
                  </div>
                </AccordionContent>
              </AccordionItem>

              <AccordionItem value="security">
                <AccordionTrigger>Security Settings</AccordionTrigger>
                <AccordionContent>
                  <div className="space-y-4">
                    <div className="flex items-center space-x-2">
                      <Switch id="ssl-required" defaultChecked />
                      <Label htmlFor="ssl-required">
                        Require SSL Connection
                      </Label>
                    </div>
                    <div className="flex items-center space-x-2">
                      <Switch id="audit-all" />
                      <Label htmlFor="audit-all">Audit All Queries</Label>
                    </div>
                    <div className="space-y-2">
                      <Label>Allowed IP Addresses</Label>
                      <Textarea
                        placeholder="Enter comma-separated IP addresses"
                        rows={3}
                      />
                    </div>
                  </div>
                </AccordionContent>
              </AccordionItem>
            </Accordion>
          </div>
          <DialogFooter>
            <Button
              variant="outline"
              onClick={() => setShowSettingsModal(false)}
            >
              Cancel
            </Button>
            <Button className="bg-gradient-to-r from-indigo-600 to-purple-600">
              Save Settings
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* View Data Modal */}
      <Dialog
        open={showViewDataModal}
        onOpenChange={setShowViewDataModal}
        modal
      >
        <DialogContent className="max-w-6xl max-h-[80vh] overflow-hidden flex flex-col">
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2">
              <Table2 className="h-5 w-5" />
              {selectedTable} - Data Browser
            </DialogTitle>
            <DialogDescription>
              Viewing {totalRecords} records from {selectedTable} table
            </DialogDescription>
          </DialogHeader>
          <div className="flex-1 overflow-auto">
            {isLoadingData ? (
              <div className="flex items-center justify-center py-12">
                <Loader2 className="h-8 w-8 animate-spin text-indigo-500" />
              </div>
            ) : currentTableData.length > 0 ? (
              <div className="space-y-4">
                <div className="flex justify-between items-center">
                  <div className="flex items-center gap-2">
                    <Button
                      size="sm"
                      onClick={() => {
                        const table = ALL_TABLES.find(
                          (t) => t.name === selectedTable,
                        );
                        if (table) handleAddRecord(table);
                      }}
                      className="gap-2"
                    >
                      <Plus className="h-4 w-4" />
                      Add Record
                    </Button>
                    <DropdownMenu>
                      <DropdownMenuTrigger asChild>
                        <Button size="sm" variant="outline" className="gap-2">
                          <Download className="h-4 w-4" />
                          Export
                        </Button>
                      </DropdownMenuTrigger>
                      <DropdownMenuContent>
                        <DropdownMenuItem
                          onClick={() =>
                            handleExportData(selectedTable!, "csv")
                          }
                        >
                          CSV Format
                        </DropdownMenuItem>
                        <DropdownMenuItem
                          onClick={() =>
                            handleExportData(selectedTable!, "json")
                          }
                        >
                          JSON Format
                        </DropdownMenuItem>
                        <DropdownMenuItem
                          onClick={() =>
                            handleExportData(selectedTable!, "sql")
                          }
                        >
                          SQL Format
                        </DropdownMenuItem>
                      </DropdownMenuContent>
                    </DropdownMenu>
                  </div>
                  <div className="text-sm text-gray-500">
                    Page {currentPage} of{" "}
                    {Math.ceil(totalRecords / recordsPerPage)}
                  </div>
                </div>
                <div className="border rounded-lg overflow-hidden">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        {Object.keys(currentTableData[0]).map((key) => (
                          <TableHead key={key} className="font-semibold">
                            {key}
                          </TableHead>
                        ))}
                        <TableHead className="text-right">Actions</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {currentTableData.map((record, idx) => (
                        <TableRow key={idx} className="hover:bg-gray-50">
                          {Object.entries(record).map(([key, value]) => (
                            <TableCell key={key} className="max-w-xs truncate">
                              {typeof value === "object"
                                ? JSON.stringify(value)
                                : String(value || "-")}
                            </TableCell>
                          ))}
                          <TableCell className="text-right">
                            <div className="flex justify-end gap-2">
                              <Button
                                size="sm"
                                variant="outline"
                                onClick={() => handleEditRecord(record)}
                              >
                                <Edit className="h-3 w-3" />
                              </Button>
                              <Button
                                size="sm"
                                variant="destructive"
                                onClick={() => handleDeleteClick(record)}
                              >
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </div>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </div>
                <div className="flex justify-center gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    disabled={currentPage === 1}
                    onClick={() =>
                      fetchTableData(selectedTable!, currentPage - 1)
                    }
                  >
                    <ChevronLeft className="h-4 w-4" />
                    Previous
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    disabled={
                      currentPage >= Math.ceil(totalRecords / recordsPerPage)
                    }
                    onClick={() =>
                      fetchTableData(selectedTable!, currentPage + 1)
                    }
                  >
                    Next
                    <ChevronRight className="h-4 w-4" />
                  </Button>
                </div>
              </div>
            ) : (
              <div className="text-center py-12 text-gray-500">
                No data available in this table
              </div>
            )}
          </div>
        </DialogContent>
      </Dialog>

      {/* Add Record Modal */}
      <Dialog open={showAddModal} onOpenChange={setShowAddModal}>
        <DialogContent className="max-w-2xl max-h-[80vh] overflow-auto">
          <DialogHeader>
            <DialogTitle>Add New Record to {selectedTable}</DialogTitle>
            <DialogDescription>
              Enter the data for the new record. Required fields are marked.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>Title/Name *</Label>
                <Input
                  placeholder="Enter title or name"
                  value={formData.title || formData.name || ""}
                  onChange={(e) =>
                    setFormData({
                      ...formData,
                      title: e.target.value,
                      name: e.target.value,
                    })
                  }
                />
              </div>
              <div className="space-y-2">
                <Label>Category</Label>
                <Input
                  placeholder="Enter category"
                  value={formData.category || ""}
                  onChange={(e) =>
                    setFormData({ ...formData, category: e.target.value })
                  }
                />
              </div>
              <div className="space-y-2">
                <Label>Location</Label>
                <Input
                  placeholder="Enter location"
                  value={formData.location || ""}
                  onChange={(e) =>
                    setFormData({ ...formData, location: e.target.value })
                  }
                />
              </div>
              <div className="space-y-2">
                <Label>Status</Label>
                <Select
                  value={formData.status || "active"}
                  onValueChange={(value) =>
                    setFormData({ ...formData, status: value })
                  }
                >
                  <SelectTrigger>
                    <SelectValue />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="active">Active</SelectItem>
                    <SelectItem value="inactive">Inactive</SelectItem>
                    <SelectItem value="pending">Pending</SelectItem>
                    <SelectItem value="draft">Draft</SelectItem>
                  </SelectContent>
                </Select>
              </div>
            </div>
            <div className="space-y-2">
              <Label>Description</Label>
              <Textarea
                placeholder="Enter description"
                value={formData.description || ""}
                onChange={(e) =>
                  setFormData({ ...formData, description: e.target.value })
                }
                rows={4}
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>Rating</Label>
                <Input
                  type="number"
                  step="0.1"
                  min="0"
                  max="5"
                  placeholder="0.0 - 5.0"
                  value={formData.rating || ""}
                  onChange={(e) =>
                    setFormData({
                      ...formData,
                      rating: parseFloat(e.target.value) || 0,
                    })
                  }
                />
              </div>
              <div className="space-y-2">
                <Label>Price/Revenue</Label>
                <Input
                  type="number"
                  placeholder="Enter amount"
                  value={formData.price || formData.revenue || ""}
                  onChange={(e) =>
                    setFormData({
                      ...formData,
                      price: parseFloat(e.target.value) || 0,
                      revenue: parseFloat(e.target.value) || 0,
                    })
                  }
                />
              </div>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowAddModal(false)}>
              Cancel
            </Button>
            <Button onClick={handleSubmitAdd} className="gap-2">
              <Plus className="h-4 w-4" />
              Create Record
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Edit Record Modal */}
      <Dialog open={showEditModal} onOpenChange={setShowEditModal}>
        <DialogContent className="max-w-2xl max-h-[80vh] overflow-auto">
          <DialogHeader>
            <DialogTitle>Edit Record in {selectedTable}</DialogTitle>
            <DialogDescription>
              Modify the record data. Changes will be saved immediately.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4">
            {Object.entries(formData)
              .filter(([key]) => key !== "created_at" && key !== "updated_at")
              .map(([key, value]) => (
                <div key={key} className="space-y-2">
                  <Label className="capitalize">{key.replace(/_/g, " ")}</Label>
                  {typeof value === "boolean" ? (
                    <div className="flex items-center space-x-2">
                      <Switch
                        checked={value}
                        onCheckedChange={(checked) =>
                          setFormData({ ...formData, [key]: checked })
                        }
                      />
                      <Label>{value ? "Yes" : "No"}</Label>
                    </div>
                  ) : key === "description" ? (
                    <Textarea
                      value={String(value || "")}
                      onChange={(e) =>
                        setFormData({ ...formData, [key]: e.target.value })
                      }
                      rows={4}
                    />
                  ) : typeof value === "number" ? (
                    <Input
                      type="number"
                      value={value || ""}
                      onChange={(e) =>
                        setFormData({
                          ...formData,
                          [key]: parseFloat(e.target.value) || 0,
                        })
                      }
                    />
                  ) : (
                    <Input
                      value={String(value || "")}
                      onChange={(e) =>
                        setFormData({ ...formData, [key]: e.target.value })
                      }
                      disabled={key === "id"}
                    />
                  )}
                </div>
              ))}
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowEditModal(false)}>
              Cancel
            </Button>
            <Button onClick={handleSubmitEdit} className="gap-2">
              <CheckCircle className="h-4 w-4" />
              Save Changes
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Delete Confirmation Modal */}
      <Dialog open={showDeleteModal} onOpenChange={setShowDeleteModal}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle className="flex items-center gap-2 text-rose-600">
              <AlertCircle className="h-5 w-5" />
              Confirm Deletion
            </DialogTitle>
            <DialogDescription>
              Are you sure you want to delete this record? This action cannot be
              undone.
            </DialogDescription>
          </DialogHeader>
          {recordToDelete && (
            <div className="bg-gray-50 p-4 rounded-lg space-y-2">
              {Object.entries(recordToDelete)
                .slice(0, 5)
                .map(([key, value]) => (
                  <div key={key} className="flex justify-between text-sm">
                    <span className="font-medium capitalize">
                      {key.replace(/_/g, " ")}:
                    </span>
                    <span className="text-gray-600">{String(value)}</span>
                  </div>
                ))}
            </div>
          )}
          <DialogFooter>
            <Button variant="outline" onClick={() => setShowDeleteModal(false)}>
              Cancel
            </Button>
            <Button
              variant="destructive"
              onClick={handleConfirmDelete}
              className="gap-2"
            >
              <XCircle className="h-4 w-4" />
              Delete Record
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}
