// Database table interface
interface DatabaseTable {
  name: string;
  schema: string;
  row_count: number;
  size_mb: number;
  category: string;
  description: string;
  columns: number;
  last_updated: string;
  has_foreign_keys: boolean;
  is_view: boolean;
  dependencies?: string[];
  indexes?: number;
  constraints?: number;
}

// Database health interface
interface DatabaseHealth {
  success: boolean;
  message: string;
  database?: {
    connected: boolean;
    name: string;
    host: string;
    port: string;
    user: string;
    version: string;
    uptime: string;
    connections: number;
  };
  tables?: DatabaseTable[];
  stats?: {
    total_tables: number;
    total_rows: number;
    total_size_mb: number;
    categories: Record<string, number>;
    active_connections: number;
    cache_hit_rate: number;
  };
}

// Query execution interface
interface QueryResult {
  success: boolean;
  data: any[];
  columns: string[];
  duration: number;
  rowCount: number;
  error?: string;
}

// Backup interface
interface Backup {
  id: string;
  filename: string;
  size: number;
  created_at: string;
  status: "completed" | "failed" | "in_progress";
  type: "full" | "partial" | "schema";
}

