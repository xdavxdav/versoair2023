import { Helmet } from 'react-helmet-async';
/**
 * Billing & Payments — Full payment hub
 * Shows all payment methods (greyed out if unavailable), Stripe pending banner,
 * PayPal as primary active, wallet transactions, auto-detected country/currency.
 */
import { useState, useEffect } from "react";
import { authenticatedFetch } from "@/lib/auth";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { motion } from "framer-motion";
import {
  CreditCard,
  Download,
  Loader2,
  Receipt,
  ArrowLeft,
  Shield,
  AlertTriangle,
  Clock,
  Zap,
  Wallet,
  FileText,
  TrendingUp,
  CheckCircle2,
  Lock,
  ChevronRight,
  ChevronDown,
  RefreshCw,
  ArrowUpRight,
} from "lucide-react";
import { Link, useLocation } from "wouter";
import { PaymentMethodSelector } from "@/components/PaymentMethodSelector";
import { PaymentTopBanner } from "@/components/PaymentTopBanner";
import { PaymentLogo, PayPalLogo } from "@/components/PaymentLogos";
import { usePaymentCountry } from "@/hooks/usePaymentCountry";
import { type PaymentMethodId, PAYMENT_METHODS } from "@/lib/payment-methods";
import { useAuthContext } from "@/contexts/AuthContext";

interface Transaction {
  id: number;
  userId: number;
  type: string;
  amount: string;
  currency: string;
  status: string;
  description: string | null;
  stripePaymentIntentId: string | null;
  createdAt: string;
}

export default function BillingPage() {
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [loading, setLoading] = useState(true);
  const [portalLoading, setPortalLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [selectedMethod, setSelectedMethod] = useState<PaymentMethodId | null>(
    "wallet",
  );
  const [activeTab, setActiveTab] = useState("overview");
  const [depositOpen, setDepositOpen] = useState(false);
  const [methodsOpen, setMethodsOpen] = useState(true);
  const [, navigate] = useLocation();
  const { countryCode, format, sortedMethods } = usePaymentCountry();
  const { user } = useAuthContext();

  // ALL 6 methods — ensure every method appears in the grid
  const allMethods = Object.values(PAYMENT_METHODS).sort(
    (a, b) => a.priority - b.priority,
  );

  useEffect(() => {
    fetchBillingHistory();
  }, []);

  async function fetchBillingHistory() {
    try {
      setLoading(true);
      setError(null);
      const res = await authenticatedFetch("/api/v1/payments/billing-history");
      if (!res.ok) {
        try {
          const errData = await res.json();
          const msg =
            errData?.error?.message || errData?.error || errData?.message;
          if (res.status === 401) {
            throw new Error("Session expired. Please sign in again.");
          }
          throw new Error(
            msg || `Failed to load billing history (${res.status})`,
          );
        } catch (parseErr: any) {
          if (
            parseErr.message.includes("Session expired") ||
            parseErr.message.includes("Failed to load")
          )
            throw parseErr;
          throw new Error(`Failed to load billing history (${res.status})`);
        }
      }
      const data = await res.json();
      setTransactions(data.transactions || data.data || []);
    } catch (err: any) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }

  async function openCustomerPortal() {
    try {
      setPortalLoading(true);
      setError(null);

      if (!user?.id) {
        throw new Error("Session missing. Please sign in again.");
      }

      const res = await authenticatedFetch("/api/v1/payments/create-portal", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: Number(user.id) }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => null);
        const msg =
          err?.error ||
          (res.status === 503
            ? "Stripe is not yet configured — billing portal unavailable until Q2 2026."
            : `Billing portal error (${res.status})`);
        throw new Error(msg);
      }
      const data = await res.json();
      const url = data.url || data.data?.url;
      if (url) {
        window.open(url, "_blank");
      } else {
        throw new Error("No portal URL returned");
      }
    } catch (err: any) {
      setError(err.message);
    } finally {
      setPortalLoading(false);
    }
  }

  const stripeReady = false; // flip to true when STRIPE_SECRET_KEY is live

  const statusColor = (status: string) => {
    switch (status) {
      case "completed":
        return "bg-green-900/30 text-green-400";
      case "pending":
        return "bg-yellow-900/30 text-yellow-400";
      case "failed":
        return "bg-red-900/30 text-red-400";
      case "refunded":
        return "bg-gray-900/30 text-gray-400";
      default:
        return "bg-blue-900/30 text-blue-400";
    }
  };

  const completedTx = transactions.filter((t) => t.status === "completed");
  const pendingTx = transactions.filter((t) => t.status === "pending");
  const totalSpent = completedTx.reduce(
    (sum, t) => sum + parseFloat(t.amount || "0"),
    0,
  );

  return (
    <>
      <Helmet>
        <title>billing — Verso Air</title>
        <meta name="description" content="billing — Verso Air" />
      </Helmet>
      <div className="min-h-screen bg-gradient-to-b from-gray-950 via-gray-900 to-gray-950 text-white">
      {/* ═══ TOP BANNER: Auto-detected country/currency/language ═══ */}
      <PaymentTopBanner subtitle="Prices and methods shown for your region" />

      <div className="max-w-5xl mx-auto px-4 py-6 space-y-6">
        {/* ═══ HEADER ═══ */}
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-4">
            <Link href="/account">
              <Button
                variant="ghost"
                size="icon"
                className="text-white hover:bg-white/10"
              >
                <ArrowLeft className="h-5 w-5" />
              </Button>
            </Link>
            <div>
              <h1 className="text-2xl font-bold">Billing & Payments</h1>
              <p className="text-sm text-gray-400">
                Manage payment methods, view history & invoices
              </p>
            </div>
          </div>
          <div className="flex gap-2">
            <Link href="/account/cards">
              <Button
                variant="outline"
                className="gap-2 border-white/10 bg-white/5 hover:bg-white/10 text-white"
              >
                <Shield className="h-4 w-4" />
                Card Vault
              </Button>
            </Link>
          </div>
        </div>

        {/* ═══ STRIPE PENDING BANNER ═══ */}
        <motion.div
          initial={{ opacity: 0, y: -10 }}
          animate={{ opacity: 1, y: 0 }}
          className="relative overflow-hidden rounded-xl border-2 border-amber-500/30 bg-gradient-to-r from-amber-950/40 via-amber-900/20 to-amber-950/40 backdrop-blur-xl"
        >
          <div className="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500" />
          <div className="p-5 flex items-start gap-4">
            <div className="p-3 rounded-xl bg-amber-500/20 flex-shrink-0">
              <AlertTriangle className="w-6 h-6 text-amber-400" />
            </div>
            <div className="flex-1">
              <div className="flex items-center gap-2 mb-1">
                <h3 className="font-bold text-amber-200 text-lg">
                  Stripe — Pending Legal Documents
                </h3>
                <Badge className="bg-amber-500/20 text-amber-300 border-amber-500/30 text-[10px]">
                  PENDING
                </Badge>
              </div>
              <p className="text-sm text-amber-200/70 leading-relaxed">
                Credit/debit card payments via Stripe are{" "}
                <strong>not yet available</strong>. We are waiting for legal
                documents to be processed. Once approved, you'll be able to pay
                with Visa, Mastercard, and Amex.
              </p>
              <div className="mt-3 flex flex-wrap items-center gap-4 text-xs text-amber-300/60">
                <span className="flex items-center gap-1">
                  <Clock className="w-3 h-3" /> Estimated: Q2 2026
                </span>
                <span className="flex items-center gap-1">
                  <CreditCard className="w-3 h-3" /> Visa, Mastercard, Amex
                </span>
                <span className="flex items-center gap-1">
                  <Zap className="w-3 h-3" /> Verso Air Card (with points)
                </span>
              </div>
            </div>
          </div>
        </motion.div>

        {/* ═══ QUICK STATS ═══ */}
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <BillingStatCard
            icon={<Wallet className="w-5 h-5" />}
            label="Wallet Balance"
            value={format(0)}
            color="purple"
          />
          <BillingStatCard
            icon={<TrendingUp className="w-5 h-5" />}
            label="Total Spent"
            value={format(totalSpent)}
            color="green"
          />
          <BillingStatCard
            icon={<Receipt className="w-5 h-5" />}
            label="Transactions"
            value={String(transactions.length)}
            color="blue"
          />
          <BillingStatCard
            icon={<Clock className="w-5 h-5" />}
            label="Pending"
            value={String(pendingTx.length)}
            color="amber"
          />
        </div>

        {/* ═══ TABS ═══ */}
        <Tabs value={activeTab} onValueChange={setActiveTab}>
          <TabsList className="bg-white/5 border border-white/10 w-full justify-start">
            <TabsTrigger
              value="overview"
              className="data-[state=active]:bg-purple-600 data-[state=active]:text-white"
            >
              Overview
            </TabsTrigger>
            <TabsTrigger
              value="methods"
              className="data-[state=active]:bg-purple-600 data-[state=active]:text-white"
            >
              Payment Methods
            </TabsTrigger>
            <TabsTrigger
              value="history"
              className="data-[state=active]:bg-purple-600 data-[state=active]:text-white"
            >
              History
            </TabsTrigger>
            <TabsTrigger
              value="invoices"
              className="data-[state=active]:bg-purple-600 data-[state=active]:text-white"
            >
              Invoices
            </TabsTrigger>
          </TabsList>

          {/* ── Overview Tab ── */}
          <TabsContent value="overview" className="mt-6 space-y-6">
            <Card className="bg-white/5 border-white/10">
              <CardHeader
                className="cursor-pointer select-none hover:bg-white/[0.02] transition-colors rounded-t-xl"
                onClick={() => setMethodsOpen(!methodsOpen)}
              >
                <CardTitle className="text-white flex items-center justify-between">
                  <span className="flex items-center gap-2">
                    <CreditCard className="w-5 h-5 text-purple-400" />
                    Active Payment Methods
                    <Badge className="bg-purple-500/15 text-purple-300 border-purple-500/25 text-[10px] px-1.5 py-0 ml-1">
                      {allMethods.filter((m) => m.available).length} active
                    </Badge>
                  </span>
                  <ChevronDown
                    className={`w-5 h-5 text-gray-400 transition-transform duration-300 ${methodsOpen ? "rotate-0" : "-rotate-90"}`}
                  />
                </CardTitle>
              </CardHeader>
              <motion.div
                initial={false}
                animate={{
                  height: methodsOpen ? "auto" : 0,
                  opacity: methodsOpen ? 1 : 0,
                }}
                transition={{ duration: 0.3, ease: "easeInOut" }}
                className="overflow-hidden"
              >
                <CardContent>
                  <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                    {allMethods.map((method) => (
                      <div
                        key={method.id}
                        className={`p-3 rounded-xl border transition-all ${
                          method.available
                            ? "border-white/10 bg-white/5 hover:border-purple-500/30 hover:bg-purple-500/5 cursor-pointer"
                            : "border-gray-800 bg-gray-900/30 opacity-50"
                        }`}
                        onClick={() => {
                          if (method.available && method.id === "paypal")
                            navigate("/account/paypal");
                        }}
                      >
                        <div className="flex items-center gap-3">
                          <PaymentLogo methodId={method.id} size={22} />
                          <div className="flex-1 min-w-0">
                            <p className="text-sm font-semibold text-white truncate">
                              {method.name}
                            </p>
                            <p className="text-[10px] text-gray-400">
                              {method.processingTime} • {method.fee}
                            </p>
                          </div>
                          {method.available ? (
                            <CheckCircle2 className="w-4 h-4 text-green-400 flex-shrink-0" />
                          ) : method.comingSoon ? (
                            <Badge className="bg-amber-500/15 text-amber-400 border-amber-500/25 text-[9px] px-1.5 py-0">
                              {method.estimatedLaunch}
                            </Badge>
                          ) : (
                            <Lock className="w-4 h-4 text-red-400 flex-shrink-0" />
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </CardContent>
              </motion.div>
            </Card>

            {/* Deposit From / Via — dropdown with all methods */}
            <motion.div
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              className="relative"
            >
              <div className="p-4 rounded-xl border border-purple-500/30 bg-gradient-to-r from-purple-950/30 via-purple-900/15 to-purple-950/30">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="p-2.5 rounded-xl bg-purple-500/15">
                      <Wallet className="w-5 h-5 text-purple-400" />
                    </div>
                    <div>
                      <h4 className="font-bold text-white">
                        Deposit From / Via
                      </h4>
                      <p className="text-[11px] text-gray-400">
                        Choose a payment method to fund your wallet
                      </p>
                    </div>
                  </div>
                  <Button
                    size="sm"
                    className="bg-purple-600 hover:bg-purple-500 text-white gap-2"
                    onClick={() => setDepositOpen(!depositOpen)}
                  >
                    Choose Method
                    <ChevronDown
                      className={`w-3.5 h-3.5 transition-transform ${depositOpen ? "rotate-180" : ""}`}
                    />
                  </Button>
                </div>

                {/* Dropdown list */}
                {depositOpen && (
                  <motion.div
                    initial={{ opacity: 0, height: 0 }}
                    animate={{ opacity: 1, height: "auto" }}
                    exit={{ opacity: 0, height: 0 }}
                    className="mt-4 space-y-1.5 border-t border-white/10 pt-4"
                  >
                    {allMethods.map((method) => {
                      const isActive = method.available;
                      const depositRoute =
                        method.id === "paypal"
                          ? "/account/paypal"
                          : method.id === "wallet"
                            ? "/account/billing"
                            : null;
                      return (
                        <button
                          key={method.id}
                          disabled={!isActive}
                          onClick={() => {
                            if (isActive && depositRoute) {
                              navigate(depositRoute);
                            }
                          }}
                          className={`w-full flex items-center gap-3 p-3 rounded-lg text-left transition-all ${
                            isActive
                              ? "bg-white/5 hover:bg-purple-500/10 border border-white/10 hover:border-purple-500/30 cursor-pointer"
                              : "bg-gray-900/20 border border-gray-800/50 opacity-40 cursor-not-allowed"
                          }`}
                        >
                          <PaymentLogo methodId={method.id} size={24} />
                          <div className="flex-1 min-w-0">
                            <p
                              className={`text-sm font-semibold truncate ${isActive ? "text-white" : "text-gray-500"}`}
                            >
                              {method.name}
                            </p>
                            <p className="text-[10px] text-gray-500">
                              {method.processingTime} • {method.fee}
                            </p>
                          </div>
                          {isActive ? (
                            <div className="flex items-center gap-1.5">
                              <Badge className="bg-green-900/30 text-green-400 border-green-500/25 text-[9px] px-1.5 py-0">
                                Active
                              </Badge>
                              {depositRoute &&
                                depositRoute !== "/account/billing" && (
                                  <ArrowUpRight className="w-3.5 h-3.5 text-purple-400" />
                                )}
                            </div>
                          ) : method.comingSoon ? (
                            <Badge className="bg-amber-500/15 text-amber-400 border-amber-500/25 text-[9px] px-1.5 py-0">
                              {method.estimatedLaunch}
                            </Badge>
                          ) : (
                            <Lock className="w-4 h-4 text-gray-600" />
                          )}
                        </button>
                      );
                    })}

                    {/* PayPal highlight */}
                    <div className="mt-2 p-3 rounded-lg bg-blue-950/20 border border-blue-500/20 flex items-center gap-3">
                      <PayPalLogo size={22} />
                      <p className="text-[11px] text-blue-300/70 flex-1">
                        <strong className="text-blue-200">
                          PayPal recommended
                        </strong>{" "}
                        — +16% bonus on deposits ≥$50. Buyer protection
                        included.
                      </p>
                      <Link href="/account/paypal">
                        <Button
                          size="sm"
                          className="bg-[#0070ba] hover:bg-[#005ea6] text-white text-xs h-7 px-3"
                        >
                          Deposit
                        </Button>
                      </Link>
                    </div>
                  </motion.div>
                )}
              </div>
            </motion.div>

            {/* Recent transactions */}
            <Card className="bg-white/5 border-white/10">
              <CardHeader className="flex flex-row items-center justify-between">
                <CardTitle className="text-white flex items-center gap-2">
                  <Receipt className="w-5 h-5 text-purple-400" />
                  Recent Transactions
                </CardTitle>
                <Button
                  variant="ghost"
                  size="sm"
                  className="text-purple-400 hover:text-purple-300"
                  onClick={() => setActiveTab("history")}
                >
                  View All <ChevronRight className="w-4 h-4 ml-1" />
                </Button>
              </CardHeader>
              <CardContent>
                {loading ? (
                  <div className="flex justify-center py-8">
                    <Loader2 className="h-6 w-6 animate-spin text-purple-400" />
                  </div>
                ) : transactions.length === 0 ? (
                  <div className="text-center py-10">
                    <Receipt className="h-10 w-10 mx-auto text-gray-600 mb-3" />
                    <p className="text-gray-400 text-sm">No transactions yet</p>
                    <p className="text-gray-500 text-xs mt-1">
                      Purchases, subscriptions, and deposits will appear here
                    </p>
                  </div>
                ) : (
                  <div className="space-y-2">
                    {transactions.slice(0, 5).map((tx) => (
                      <TransactionRow
                        key={tx.id}
                        tx={tx}
                        statusColor={statusColor}
                      />
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          {/* ── Payment Methods Tab ── */}
          <TabsContent value="methods" className="mt-6">
            <PaymentMethodSelector
              selectedMethod={selectedMethod}
              onSelect={setSelectedMethod}
              amount={0}
              countryCode={countryCode}
              showComingSoon={true}
            />
          </TabsContent>

          {/* ── History Tab ── */}
          <TabsContent value="history" className="mt-6">
            <Card className="bg-white/5 border-white/10">
              <CardHeader className="flex flex-row items-center justify-between">
                <CardTitle className="text-white">All Transactions</CardTitle>
                <Button
                  variant="ghost"
                  size="sm"
                  className="text-purple-400 gap-1"
                >
                  <Download className="w-4 h-4" /> Export CSV
                </Button>
              </CardHeader>
              <CardContent>
                {loading ? (
                  <div className="flex justify-center py-12">
                    <Loader2 className="h-8 w-8 animate-spin text-purple-400" />
                  </div>
                ) : transactions.length === 0 ? (
                  <div className="text-center py-16">
                    <Receipt className="h-12 w-12 mx-auto text-gray-600 mb-4" />
                    <h3 className="text-lg font-medium text-white mb-2">
                      No transactions yet
                    </h3>
                    <p className="text-sm text-gray-400 mb-6">
                      When you upgrade your subscription or make a purchase,
                      your transactions will appear here.
                    </p>
                    <Link href="/pricing">
                      <Button className="bg-purple-600 hover:bg-purple-500">
                        View Plans
                      </Button>
                    </Link>
                  </div>
                ) : (
                  <div className="space-y-2">
                    {transactions.map((tx) => (
                      <TransactionRow
                        key={tx.id}
                        tx={tx}
                        statusColor={statusColor}
                      />
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          {/* ── Invoices Tab ── */}
          <TabsContent value="invoices" className="mt-6">
            <Card className="bg-white/5 border-white/10">
              <CardContent className="py-16 text-center">
                <FileText className="h-12 w-12 mx-auto text-gray-600 mb-4" />
                <h3 className="text-lg font-medium text-white mb-2">
                  Invoices
                </h3>
                <p className="text-sm text-gray-400 mb-4">
                  Invoice generation coming soon. Completed transactions will
                  automatically create downloadable invoices.
                </p>
                <Badge className="bg-amber-500/20 text-amber-300 border-amber-500/30">
                  Coming Q2 2026
                </Badge>
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>

        {/* ═══ QUICK LINKS ═══ */}
        <div className="flex flex-wrap items-center gap-3 pt-4 border-t border-white/10">
          <span className="text-[10px] text-gray-500 uppercase tracking-wider font-medium">
            Navigate:
          </span>
          <Link href="/music/dashboard">
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-purple-400 hover:bg-purple-500/10 hover:border-purple-500/30 transition-all cursor-pointer">
              🎵 Music Dashboard
            </span>
          </Link>
          <Link href="/music/vault">
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-purple-400 hover:bg-purple-500/10 hover:border-purple-500/30 transition-all cursor-pointer">
              🎶 Music Vault
            </span>
          </Link>
          <Link href="/streamer-portal">
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-purple-400 hover:bg-purple-500/10 hover:border-purple-500/30 transition-all cursor-pointer">
              📡 Streamer Portal
            </span>
          </Link>
          <Link href="/reservations">
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-purple-400 hover:bg-purple-500/10 hover:border-purple-500/30 transition-all cursor-pointer">
              🏠 Reservations
            </span>
          </Link>
          <Link href="/music/royalties">
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-xs text-purple-400 hover:bg-purple-500/10 hover:border-purple-500/30 transition-all cursor-pointer">
              💰 Royalties
            </span>
          </Link>
        </div>
      </div>
    </div>
  );
}

/* ── Stats Card ── */
function BillingStatCard({
  icon,
  label,
  value,
  color,
}: {
  icon: React.ReactNode;
  label: string;
  value: string;
  color: "purple" | "green" | "blue" | "amber";
}) {
  const colors = {
    purple:
      "from-purple-600/20 to-purple-900/10 border-purple-500/20 text-purple-400",
    green:
      "from-green-600/20 to-green-900/10 border-green-500/20 text-green-400",
    blue: "from-blue-600/20 to-blue-900/10 border-blue-500/20 text-blue-400",
    amber:
      "from-amber-600/20 to-amber-900/10 border-amber-500/20 text-amber-400",
  };
  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      className={`p-4 rounded-xl border bg-gradient-to-br ${colors[color]}`}
    >
      <div className="flex items-center gap-2 mb-2">{icon}</div>
      <p className="text-lg font-bold text-white">{value}</p>
      <p className="text-xs text-gray-400">{label}</p>
    </motion.div>
  );
}

