import { Helmet } from 'react-helmet-async';
import { useEffect, useMemo, useState } from "react";
import { motion } from "framer-motion";
import { Link, useRoute } from "wouter";
import {
  ArrowLeft,
  Calendar,
  FileText,
  Heart,
  Link as LinkIcon,
  Loader2,
  MapPin,
  MessageCircle,
  Music,
  Play,
  User,
  Users,
} from "lucide-react";
import FollowButton from "@/components/FollowButton";
import { useAuthContext } from "@/contexts/AuthContext";
import { useToast } from "@/hooks/use-toast";
import { authenticatedFetch } from "@/lib/auth";

type ActiveTab = "overview" | "tracks" | "posts";

interface PublicUserProfile {
  id: number;
  username: string;
  name: string;
  avatar: string | null;
  bio: string | null;
  location: string | null;
  website: string | null;
  role: string;
  tier: string;
  isArtist: boolean;
  isFollowing: boolean;
  joinedAt: string | null;
  stats: {
    followerCount: number;
    followingCount: number;
    trackCount: number;
    postCount: number;
    streamCount: number;
    likeCount: number;
  };
}

function formatCompact(value: number) {
  return value >= 1000 ? `${(value / 1000).toFixed(1)}K` : String(value);
}

export default function UserProfilePage() {
  const [match, params] = useRoute("/user/:id");
  const userId = params?.id;
  const { user: me } = useAuthContext();
  const { toast } = useToast();
  const [profile, setProfile] = useState<PublicUserProfile | null>(null);
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState<ActiveTab>("overview");
  const [tracks, setTracks] = useState<any[]>([]);
  const [posts, setPosts] = useState<any[]>([]);
  const [tabLoading, setTabLoading] = useState(false);

  useEffect(() => {
    if (!match || !userId) return;

    let cancelled = false;
    setLoading(true);

    authenticatedFetch(`/api/social/users/${userId}`)
      .then((response) => (response.ok ? response.json() : null))
      .then((json) => {
        if (cancelled || !json?.data) return;
        setProfile(json.data);
      })
      .catch(() => {
        if (!cancelled) setProfile(null);
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });

    return () => {
      cancelled = true;
    };
  }, [match, userId]);

  // Fetch tab data when activeTab changes
  useEffect(() => {
    if (!userId || !profile) return;

    let cancelled = false;
    setTabLoading(true);

    if (activeTab === "tracks" || activeTab === "overview") {
      // Load tracks for both tracks tab and overview (for "latest track" preview)
      if (tracks.length === 0) {
        authenticatedFetch(`/api/social/users/${userId}/tracks?limit=20`)
          .then((r) => (r.ok ? r.json() : null))
          .then((json) => {
            if (!cancelled && json?.data) setTracks(json.data);
          })
          .catch(() => {})
          .finally(() => {
            if (!cancelled) setTabLoading(false);
          });
      } else {
        setTabLoading(false);
      }
    } else if (activeTab === "posts") {
      if (posts.length === 0) {
        authenticatedFetch(`/api/social/users/${userId}/posts?limit=20`)
          .then((r) => (r.ok ? r.json() : null))
          .then((json) => {
            if (!cancelled && json?.data) setPosts(json.data);
          })
          .catch(() => {})
          .finally(() => {
            if (!cancelled) setTabLoading(false);
          });
      } else {
        setTabLoading(false);
      }
    } else {
      setTabLoading(false);
    }

    return () => {
      cancelled = true;
    };
  }, [activeTab, userId, profile, tracks.length, posts.length]);

  const isMe = me?.id === userId;

  const initials = useMemo(() => {
    if (!profile?.name) return "VA";
    return profile.name
      .split(/\s+/)
      .slice(0, 2)
      .map((part) => part[0])
      .join("")
      .toUpperCase();
  }, [profile]);

  const handleBack = () => {
    if (window.history.length > 1) window.history.back();
    else window.location.href = "/";
  };

  const handleMessage = async () => {
    if (!profile) return;
    if (!me) {
      toast({
        title: "Sign in required",
        description: "Please log in to send messages.",
        variant: "destructive",
      });
      return;
    }

    try {
      const type = profile.isArtist ? "music_artist" : "marketplace";
      const response = await authenticatedFetch("/api/inbox/conversations", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          participantId: String(profile.id),
          participantName: profile.name,
          participantAvatar: profile.avatar,
          type,
        }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data?.success) {
        throw new Error(data?.error || "Could not open conversation");
      }
      window.dispatchEvent(new Event("messenger:open"));
    } catch (error) {
      toast({
        title: "Message unavailable",
        description:
          error instanceof Error
            ? error.message
            : "Could not open conversation.",
        variant: "destructive",
      });
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950">
        <div className="max-w-4xl mx-auto px-4 py-8">
          <div className="mb-6">
            <div className="w-24 h-8 bg-white/5 rounded-lg animate-pulse" />
          </div>
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            className="bg-white/[0.03] backdrop-blur-xl rounded-2xl border border-white/10 p-6 mb-6"
          >
            <div className="flex flex-col md:flex-row gap-6">
              <div className="w-32 h-32 rounded-full bg-white/5 animate-pulse shrink-0" />
              <div className="flex-1 space-y-4">
                <div className="h-8 bg-white/5 rounded-lg w-48 animate-pulse" />
                <div className="h-4 bg-white/5 rounded w-32 animate-pulse" />
                <div className="h-12 bg-white/5 rounded w-full animate-pulse" />
                <div className="flex gap-3">
                  <div className="h-10 bg-white/5 rounded-lg w-32 animate-pulse" />
                  <div className="h-10 bg-white/5 rounded-lg w-32 animate-pulse" />
                </div>
              </div>
            </div>
          </motion.div>
          <div className="grid grid-cols-3 md:grid-cols-6 gap-3 mb-6">
            {[1, 2, 3, 4, 5, 6].map((i) => (
              <div
                key={i}
                className="h-24 bg-white/5 rounded-xl animate-pulse"
              />
            ))}
          </div>
          <div className="h-64 bg-white/5 rounded-2xl animate-pulse" />
        </div>
      </div>
    );
  }

  if (!profile) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 flex items-center justify-center p-4">
        <div className="text-center space-y-4">
          <User className="w-16 h-16 text-slate-600 mx-auto" />
          <h2 className="text-white text-xl font-bold">User not found</h2>
          <p className="text-slate-400">
            This profile doesn&apos;t exist or was removed.
          </p>
          <Link href="/">
            <button className="px-6 py-2 bg-amber-500 text-white rounded-lg font-medium hover:bg-amber-600 transition-colors">
              Go Home
            </button>
          </Link>
        </div>
      </div>
    );
  }

  const statItems = [
    { label: "Followers", value: profile.stats.followerCount, icon: Users },
    { label: "Following", value: profile.stats.followingCount, icon: User },
    { label: "Tracks", value: profile.stats.trackCount, icon: Music },
    { label: "Posts", value: profile.stats.postCount, icon: FileText },
    { label: "Streams", value: profile.stats.streamCount, icon: Play },
    { label: "Likes", value: profile.stats.likeCount, icon: Heart },
  ];

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950">
      <div className="relative h-40 md:h-56 overflow-hidden">
        <div className="absolute inset-0 bg-gradient-to-br from-amber-700/20 via-violet-600/15 to-slate-950" />
        <div className="absolute inset-0 bg-gradient-to-b from-transparent to-slate-950" />
      </div>

      <div className="max-w-4xl mx-auto px-4 -mt-20 relative z-10 pb-16">
        <button
          type="button"
          onClick={handleBack}
          className="flex items-center gap-2 p-2 rounded-lg bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/10 transition-all text-white mb-6"
        >
          <ArrowLeft className="w-5 h-5" />
        </button>

        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="bg-white/[0.03] backdrop-blur-xl rounded-2xl border border-white/10 p-6 md:p-8 mb-6"
        >
          <div className="flex flex-col md:flex-row gap-6 items-start">
            <div className="w-24 h-24 md:w-32 md:h-32 rounded-full border-4 border-slate-900 bg-gradient-to-br from-amber-500 to-violet-600 flex items-center justify-center text-white text-3xl font-bold shrink-0 ring-2 ring-amber-500/50 overflow-hidden">
              {profile.avatar ? (
                <img
                  src={profile.avatar}
                  alt={profile.name}
                  className="w-full h-full object-cover"
                  onError={(event) => {
                    event.currentTarget.style.display = "none";
                  }}
                />
              ) : (
                initials
              )}
            </div>

            <div className="flex-1 min-w-0">
              <h1 className="text-2xl md:text-3xl font-bold text-white mb-1">
                {profile.name}
              </h1>
              <p className="text-slate-400 text-sm mb-3">@{profile.username}</p>

              {profile.bio && (
                <p className="text-slate-300 text-sm mb-4 max-w-xl">
                  {profile.bio}
                </p>
              )}

              <div className="flex flex-wrap gap-2 mb-4">
                {profile.isArtist && (
                  <span className="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-violet-500/20 border border-violet-500/30 text-violet-300">
                    <Music className="w-3 h-3" /> Artist
                  </span>
                )}
                <span className="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-slate-300">
                  {profile.role}
                </span>
                <span className="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-white/5 border border-white/10 text-slate-300">
                  <Calendar className="w-3 h-3" />
                  Joined{" "}
                  {profile.joinedAt
                    ? new Date(profile.joinedAt).toLocaleDateString()
                    : "Unknown"}
                </span>
              </div>

              <div className="flex flex-wrap gap-4 text-sm text-slate-400 mb-5">
                {profile.location && (
                  <span className="flex items-center gap-1">
                    <MapPin className="w-3.5 h-3.5" /> {profile.location}
                  </span>
                )}
                {profile.website && (
                  <a
                    href={profile.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-1 text-amber-400 hover:text-amber-300 transition-colors"
                  >
                    <LinkIcon className="w-3.5 h-3.5" /> Website
                  </a>
                )}
              </div>

              {!isMe && (
                <div className="flex gap-3 flex-wrap">
                  <FollowButton
                    userId={profile.id}
                    initialIsFollowing={profile.isFollowing}
                    initialFollowerCount={profile.stats.followerCount}
                    onFollowChange={(isFollowing, count) => {
                      setProfile((prev) =>
                        prev
                          ? {
                              ...prev,
                              isFollowing,
                              stats: { ...prev.stats, followerCount: count },
                            }
                          : prev,
                      );
                    }}
                  />
                  <motion.button
                    type="button"
                    whileHover={{ scale: 1.03 }}
                    whileTap={{ scale: 0.97 }}
                    onClick={handleMessage}
                    className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 text-white border border-white/10 hover:bg-white/10 transition-all text-sm font-medium"
                  >
                    <MessageCircle className="w-4 h-4" />
                    Message
                  </motion.button>
                </div>
              )}
            </div>
          </div>
        </motion.div>

        <motion.div
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ delay: 0.1 }}
          className="grid grid-cols-3 md:grid-cols-6 gap-3 mb-6"
        >
          {statItems.map((stat) => {
            const Icon = stat.icon;
            return (
              <div
                key={stat.label}
                className="bg-white/[0.03] backdrop-blur-xl rounded-xl border border-white/10 p-4 text-center hover:border-amber-500/30 transition-colors"
              >
                <Icon className="w-4 h-4 text-amber-500 mx-auto mb-2" />
                <p className="text-lg font-bold text-white">
                  {formatCompact(stat.value)}
                </p>
                <p className="text-[10px] text-slate-400 uppercase tracking-wider">
                  {stat.label}
                </p>
              </div>
            );
          })}
        </motion.div>

        <div className="flex gap-1 bg-white/[0.03] backdrop-blur-xl rounded-xl border border-white/10 p-1 mb-6">
          {[
            { id: "overview" as const, label: "Overview", icon: User },
            { id: "tracks" as const, label: "Tracks", icon: Music },
            { id: "posts" as const, label: "Posts", icon: FileText },
          ].map((tab) => {
            const Icon = tab.icon;
            return (
              <button
                key={tab.id}
                type="button"
                onClick={() => setActiveTab(tab.id)}
                className={`flex-1 flex items-center justify-center gap-2 py-2.5 rounded-lg text-sm font-medium transition-all ${
                  activeTab === tab.id
                    ? "bg-amber-500/15 text-amber-400 border border-amber-500/20"
                    : "text-slate-400 hover:text-white hover:bg-white/5"
                }`}
              >
                <Icon className="w-4 h-4" />
                <span className="hidden sm:inline">{tab.label}</span>
              </button>
            );
          })}
        </div>

        <motion.div
          key={activeTab}
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          className="bg-white/[0.03] backdrop-blur-xl rounded-2xl border border-white/10 p-6 min-h-[200px]"
        >
          {tabLoading ? (
            <div className="flex items-center justify-center py-16">
              <Loader2 className="w-6 h-6 text-amber-500 animate-spin" />
            </div>
          ) : activeTab === "overview" ? (
            <div className="space-y-4">
              <h3 className="text-white font-semibold">About</h3>
              <p className="text-slate-400 text-sm">
                {profile.bio || "No bio yet."}
              </p>
              {tracks.length > 0 && profile.isArtist && (
                <>
                  <h3 className="text-white font-semibold pt-4">
                    Latest Track
                  </h3>
                  <motion.div
                    whileHover={{ scale: 1.02 }}
                    className="flex items-center gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-amber-500/30 transition-colors cursor-pointer"
                    onClick={() =>
                      (window.location.href = `/streaming/${tracks[0].id}`)
                    }
                  >
                    <div className="w-12 h-12 rounded-lg bg-gradient-to-br from-amber-500/20 to-violet-600/20 flex items-center justify-center overflow-hidden shrink-0">
                      {tracks[0].coverArt ? (
                        <img
                          src={tracks[0].coverArt}
                          alt=""
                          className="w-full h-full object-cover"
                          onError={(e) => {
                            (e.target as HTMLImageElement).style.display =
                              "none";
                          }}
                        />
                      ) : (
                        <Music className="w-5 h-5 text-amber-500/50" />
                      )}
                    </div>
                    <div className="flex-1 min-w-0">
                      <p className="text-white text-sm font-medium truncate">
                        {tracks[0].title}
                      </p>
                      <p className="text-slate-500 text-xs">
                        {tracks[0].genre || "Music"}
                      </p>
                    </div>
                    <Play className="w-4 h-4 text-amber-500" />
                  </motion.div>
                </>
              )}
            </div>
          ) : activeTab === "tracks" ? (
            tracks.length === 0 ? (
              <div className="text-center py-12">
                <Music className="w-12 h-12 text-slate-600 mx-auto mb-3" />
                <p className="text-slate-400 text-sm">
                  No tracks published yet.
                </p>
              </div>
            ) : (
              <div className="space-y-3">
                {tracks.map((track, idx) => (
                  <motion.div
                    key={track.id}
                    initial={{ opacity: 0, y: 8 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: idx * 0.05 }}
                    whileHover={{ scale: 1.01, x: 4 }}
                    className="flex items-center gap-4 p-3 rounded-xl bg-white/[0.03] border border-white/10 hover:border-amber-500/30 transition-all group cursor-pointer"
                    onClick={() =>
                      (window.location.href = `/streaming/${track.id}`)
                    }
                  >
                    <div className="w-14 h-14 rounded-lg bg-gradient-to-br from-amber-500/20 to-violet-600/20 flex items-center justify-center shrink-0 overflow-hidden">
                      {track.coverArt ? (
                        <img
                          src={track.coverArt}
                          alt={track.title}
                          className="w-full h-full object-cover"
                          onError={(e) => {
                            (e.target as HTMLImageElement).style.display =
                              "none";
                          }}
                        />
                      ) : (
                        <Music className="w-6 h-6 text-amber-500/50" />
                      )}
                    </div>
                    <div className="flex-1 min-w-0">
                      <h4 className="text-white font-medium text-sm truncate group-hover:text-amber-400 transition-colors">
                        {track.title}
                      </h4>
                      <p className="text-slate-500 text-xs">
                        {track.genre || "Music"} · {track.playCount || 0} plays
                      </p>
                    </div>
                    <div className="text-slate-500 text-xs shrink-0">
                      {track.duration
                        ? `${Math.floor(track.duration / 60)}:${String(
                            track.duration % 60,
                          ).padStart(2, "0")}`
                        : "--:--"}
                    </div>
                    <Play className="w-4 h-4 text-amber-500 opacity-0 group-hover:opacity-100 transition-opacity" />
                  </motion.div>
                ))}
              </div>
            )
          ) : activeTab === "posts" ? (
            posts.length === 0 ? (
              <div className="text-center py-12">
                <FileText className="w-12 h-12 text-slate-600 mx-auto mb-3" />
                <p className="text-slate-400 text-sm">No posts yet.</p>
              </div>
            ) : (
              <div className="space-y-4">
                {posts.map((post, idx) => (
                  <motion.div
                    key={post.id}
                    initial={{ opacity: 0, y: 8 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: idx * 0.05 }}
                    whileHover={{ scale: 1.01 }}
                    className="p-4 rounded-xl bg-white/[0.03] border border-white/10 hover:border-amber-500/30 transition-all"
                  >
                    <div className="flex items-center gap-3 mb-3">
                      <div className="w-8 h-8 rounded-full bg-gradient-to-br from-amber-500 to-violet-600 flex items-center justify-center text-white text-xs font-bold overflow-hidden shrink-0">
                        {profile?.avatar ? (
                          <img
                            src={profile.avatar}
                            alt=""
                            className="w-full h-full object-cover"
                            onError={(e) => {
                              (e.target as HTMLImageElement).style.display =
                                "none";
                            }}
                          />
                        ) : (
                          initials
                        )}
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-white text-sm font-medium truncate">
                          {profile?.name}
                        </p>
                        <p className="text-slate-500 text-[11px]">
                          {new Date(post.createdAt).toLocaleDateString(
                            "en-US",
                            {
                              month: "short",
                              day: "numeric",
                              year: "numeric",
                            },
                          )}
                        </p>
                      </div>
                    </div>
                    <p className="text-slate-300 text-sm whitespace-pre-wrap leading-relaxed">
                      {post.content}
                    </p>
                    {post.mediaUrl && (
                      <div className="mt-3 rounded-lg overflow-hidden border border-white/10">
                        <img
                          src={post.mediaUrl}
                          alt="Post media"
                          className="w-full max-h-64 object-cover"
                          onError={(e) => {
                            (e.target as HTMLImageElement).style.display =
                              "none";
                          }}
                        />
                      </div>
                    )}
                    {post.track && (
                      <div className="mt-3 p-3 rounded-lg bg-white/[0.05] border border-amber-500/20 flex items-center gap-3">
                        <Music className="w-5 h-5 text-amber-500 shrink-0" />
                        <div className="flex-1 min-w-0">
                          <p className="text-white text-sm font-medium truncate">
                            {post.track.title}
                          </p>
                          <p className="text-slate-500 text-xs">
                            Attached Track
                          </p>
                        </div>
                      </div>
                    )}
                    <div className="flex items-center gap-4 mt-3 pt-3 border-t border-white/5">
                      <span className="text-slate-500 text-xs flex items-center gap-1.5">
                        <Heart className="w-3.5 h-3.5" /> {post.likeCount || 0}
                      </span>
                      <span className="text-slate-500 text-xs flex items-center gap-1.5">
                        <MessageCircle className="w-3.5 h-3.5" />
                        {post.commentCount || 0}
                      </span>
                    </div>
                  </motion.div>
                ))}
              </div>
            )
          ) : null}
        </motion.div>
      </div>
    </div>
  );
}
